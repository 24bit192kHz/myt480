#!/usr/bin/env python3
"""chadwm-view empty|prev|MASK : ask chadwm (_CHADWM_VIEW) to change the view.
empty = first tag without windows, prev = previous tagset, MASK = tag bitmask."""
import sys
from Xlib import X, display, protocol
arg = sys.argv[1] if len(sys.argv) > 1 else ""
val = {"empty": 0x80000000, "prev": 0}.get(arg)
if val is None:
    val = int(arg, 0)
d = display.Display()
root = d.screen().root
ev = protocol.event.ClientMessage(window=root, client_type=d.intern_atom("_CHADWM_VIEW"),
                                  data=(32, [val, 0, 0, 0, 0]))
root.send_event(ev, event_mask=X.SubstructureRedirectMask | X.SubstructureNotifyMask)
d.sync()
