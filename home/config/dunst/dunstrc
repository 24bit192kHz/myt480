# GENERATED by theme-sync.sh from theme/palette.conf — do not hand-edit.
[global]
    monitor = 0
    follow = keyboard
    width = 320
    height = (0, 160)
    origin = top-right
    offset = (12, 48)
    notification_limit = 4
    padding = 10
    horizontal_padding = 12
    frame_width = 1
    frame_color = "#3a3a3a"
    separator_color = frame
    corner_radius = 4
    gap_size = 6
    font = JetBrainsMono Nerd Font 10
    format = "<b>%s</b>\n%b"
    alignment = left
    icon_position = left
    max_icon_size = 32
    enable_recursive_icon_lookup = true
    icon_theme = Papirus-Dark-Grey
    idle_threshold = 120
    show_age_threshold = -1
    sticky_history = yes
    history_length = 20
    browser = /usr/bin/xdg-open
    mouse_left_click = do_action, close_current
    mouse_right_click = close_all
[urgency_low]
    background = "#101010"
    foreground = "#6e6e6e"
    timeout = 4
[urgency_normal]
    background = "#101010"
    foreground = "#e4e4e4"
    timeout = 6
[urgency_critical]
    background = "#101010"
    foreground = "#f0f0f0"
    frame_color = "#cc3333"
    timeout = 0
