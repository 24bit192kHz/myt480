/* GENERATED by theme-sync.sh from theme/palette.conf — do not hand-edit. */
* {
    bg-col:       #101010;
    bg-col-light: #1e1e1e;
    border-col:   #3a3a3a;
    selected-col: #2a2a2a;
    fg-col:       #e4e4e4;
    fg-col2:      #f0f0f0;
    grey:         #6e6e6e;
    accent:       #cfcfcf;
}
window { width: 768px; border: 2px; border-color: @border-col; border-radius: 10px; background-color: @bg-col; padding: 15px; }
mainbox { background-color: @bg-col; spacing: 10px; }
inputbar { children: [ prompt, entry ]; background-color: @bg-col-light; border-radius: 7px; padding: 8px; }
prompt { background-color: @fg-col; text-color: @bg-col; padding: 8px 12px; border-radius: 5px; }
textbox-prompt-colon { expand: false; str: ""; }
entry { padding: 8px 12px; text-color: @fg-col; background-color: @bg-col-light; }
listview { background-color: @bg-col; padding: 8px 0px 0px; columns: 2; spacing: 8px; lines: 8; }
element { padding: 8px; border-radius: 5px; background-color: @bg-col; text-color: @fg-col; }
element-icon { size: 28px; margin: 0px 10px 0px 0px; }
element-text { background-color: @bg-col; text-color: @fg-col; vertical-align: 0.5; }
element selected { background-color: @selected-col; text-color: @fg-col2; }
element selected element-text { background-color: @selected-col; text-color: @fg-col2; }
mode-switcher { background-color: @bg-col; spacing: 8px; }
button { padding: 10px 15px; border-radius: 5px; background-color: @bg-col-light; text-color: @grey; border: 0px; }
button selected { background-color: @selected-col; text-color: @accent; border: 0px; }
scrollbar { handle-width: 5px; handle-color: @border-col; background-color: @bg-col; }
