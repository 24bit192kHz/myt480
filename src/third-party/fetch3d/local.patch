+          dprintf(pinned_report, "%d %d\n", child < 0 ? 0 : (int)child,
+                  header_rows);
+          _exit(child < 0);
+        }
+        setsid(); // no SIGINT/SIGHUP from the tty; exits on EIO instead
+        close(pinned_report);
+        int devnull = open("/dev/null", O_RDONLY);
+        if (devnull >= 0) {
+          dup2(devnull, STDIN_FILENO);
+          close(devnull);
+        }
+        usleep(1000000 / fps);
+        continue;
+      }
+    }
+    // One complete write per frame, so it never interleaves with the shell's.
+    // A tty write cut short by a signal returns what it wrote so far; the
+    // shell's output could then land between the halves while the cursor is
+    // in the header (the shell signals us at every prompt). Hold signals
+    // until the whole frame is out.
+    sigset_t hold, unhold;
+    sigemptyset(&hold);
+    if (pinned) {
+      sigaddset(&hold, SIGUSR1);
+      sigaddset(&hold, SIGUSR2);
+      sigaddset(&hold, SIGWINCH);
+      sigaddset(&hold, SIGTERM);
+      sigaddset(&hold, SIGINT);
+    }
+    sigprocmask(SIG_BLOCK, &hold, &unhold);
+    size_t len = p - out_buf, off = 0;
+    ssize_t w = 0;
+    while (off < len) {
+      w = write(STDOUT_FILENO, out_buf + off, len - off);
+      if (w < 0 && errno == EINTR)
+        continue;
+      if (w <= 0)
+        break;
+      off += w;
+    }
+    sigprocmask(SIG_SETMASK, &unhold, NULL);
+    if (w < 0)
       break;
-    usleep(50000);
+    usleep(1000000 / fps);
+    if (pinned) {
+      if (pinned_paused) {
+        // Sleep until SIGUSR2; SIGUSR2 is blocked except inside pselect, so
+        // it can't slip in between the check and the wait. Wake once a
+        // second only to notice a closed terminal.
+        sigset_t usr2, old;
+        sigemptyset(&usr2);
+        sigaddset(&usr2, SIGUSR2);
+        sigprocmask(SIG_BLOCK, &usr2, &old);
+        while (pinned_paused && kill(shell_pid, 0) == 0) {
+          struct timespec ts = {1, 0};
+          pselect(0, NULL, NULL, NULL, &ts, &old);
+        }
+        sigprocmask(SIG_SETMASK, &old, NULL);
+      }
+      struct winsize ws;
+      if (ioctl(STDOUT_FILENO, TIOCGWINSZ, &ws) == 0 &&
+          (ws.ws_row != term_rows || ws.ws_col != term_cols))
+        term_resized = 1;
+      if (frame % fps == 0 && kill(shell_pid, 0) != 0)
+        break;
+    }
   }
 
