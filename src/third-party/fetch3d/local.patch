+// compact=1: every system battery as one value (the T480 has an internal and
+// an external pack), weighted by energy. Device batteries (mice) are skipped.
+static int gather_battery_total(void) {
+  DIR *d = opendir("/sys/class/power_supply");
+  if (!d)
+    return 0;
+  long now = 0, full = 0;
+  int charging = 0, discharging = 0, all_full = 1;
+  struct dirent *e;
+  while ((e = readdir(d))) {
+    char buf[64];
+    if (e->d_name[0] == '.' ||
+        read_power_supply(e->d_name, "type", buf, sizeof(buf)) < 0 ||
+        strcmp(buf, "Battery") != 0)
+      continue;
+    if (read_power_supply(e->d_name, "scope", buf, sizeof(buf)) >= 0 &&
+        strcmp(buf, "Device") == 0)
+      continue;
+    long n = read_power_supply(e->d_name, "energy_now", NULL, 0);
+    long f = read_power_supply(e->d_name, "energy_full", NULL, 0);
+    if (n < 0 || f <= 0) {
+      n = read_power_supply(e->d_name, "charge_now", NULL, 0);
+      f = read_power_supply(e->d_name, "charge_full", NULL, 0);
+    }
+    if (n < 0 || f <= 0)
+      continue;
+    now += n;
+    full += f;
+    if (read_power_supply(e->d_name, "status", buf, sizeof(buf)) >= 0) {
+      charging |= strcmp(buf, "Charging") == 0;
+      discharging |= strcmp(buf, "Discharging") == 0;
+      all_full &= strcmp(buf, "Full") == 0;
+    }
+  }
+  closedir(d);
+  if (full <= 0)
+    return 0;
+  add_info("Battery", "%d%% [%s]", (int)((now * 100 + full / 2) / full),
+           charging      ? "Charging"
+           : discharging ? "Discharging"
+           : all_full    ? "Full"
+                         : "Not charging");
+  return 1;
+}
+#endif
