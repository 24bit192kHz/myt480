+// Drop SGR sequences (the green/yellow/red percentages) so compact values
+// take a single colour.
+static void strip_sgr(char *s) {
+  char *w = s;
+  for (char *r = s; *r;) {
+    if (r[0] == '\033' && r[1] == '[') {
+      r += 2;
+      while (*r && *r != 'm')
+        r++;
+      if (*r)
+        r++;
+    } else {
+      *w++ = *r++;
+    }
+  }
+  *w = '\0';
+}
+
+static void cut_at(char *s, const char *needle) {
+  char *q = strstr(s, needle);
+  if (q)
+    *q = '\0';
+}
+
+// Rewrite val in place into a tidier form; returns the lowercase label.
+static const char *compact_field(const char *label, char *val) {
+  strip_sgr(val);
+  if (strcmp(label, "OS") == 0) {
+    char *sp = strrchr(val, ' ');
+    if (sp && (strcmp(sp + 1, "x86_64") == 0 || strcmp(sp + 1, "aarch64") == 0))
+      *sp = '\0';
+    return "os";
+  }
+  if (strcmp(label, "Kernel") == 0)
+    return "kernel";
+  if (strcmp(label, "Uptime") == 0)
+    return "uptime";
+  if (strcmp(label, "Packages") == 0)
+    return "packages";
+  if (strcmp(label, "Memory") == 0 || strcmp(label, "Swap") == 0) {
+    float used, total;
+    int pct;
+    if (sscanf(val, "%f GiB / %f GiB (%d%%)", &used, &total, &pct) == 3)
+      snprintf(val, MAX_LINE_LEN, "%.1f GiB / %.1f GiB (%d%%)", used, total,
+               pct);
+    return label[0] == 'M' ? "memory" : "swap";
+  }
+  if (strncmp(label, "Battery", 7) == 0) {
+    // "37% (2 hours, 31 mins remaining) [Discharging]" -> "37%, discharging"
+    char status[32] = "";
+    char *lb = strrchr(val, '[');
+    if (lb && sscanf(lb, "[%31[^]]", status) == 1)
+      for (char *c = status; *c; c++)
+        *c = tolower((unsigned char)*c);
+    cut_at(val, " ");
+    if (status[0] && strcmp(status, "unknown") != 0) {
+      strcat(val, ", ");
+      strcat(val, status);
+    }
+    return "battery";
+  }
+  if (strncmp(label, "Disk", 4) == 0)
+    return "disk";
+  if (strcmp(label, "CPU") == 0) {
+    cut_at(val, " @");
+    return "cpu";
+  }
+  if (strcmp(label, "Shell") == 0)
+    return "shell";
+  if (strcmp(label, "Terminal") == 0)
+    return "terminal";
+  if (strcmp(label, "WM") == 0)
+    return "wm";
+  return label;
+}
