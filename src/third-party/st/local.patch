+			int dst = (j-1) * XSHAPE_MAXG + celln[j-1];
+			int src = j * XSHAPE_MAXG + t;
+			cellgid[dst] = cellgid[src];
+			cellgfont[dst] = cellgfont[src];
+			celladv[dst] = celladv[src];
+			celloffx[dst] = celloffx[src];
+			celloffy[dst] = celloffy[src];
+			celln[j-1]++;
+		}
+		celln[j] = 0;
+		merged[j] = 1;
+	}
+
+	/* Emit in visual order with the shaped pen: each glyph is placed at
+	 * pen + offset and pen advances by the shaped advance, so cursive
+	 * joins meet and spaces take their natural width. The grid itself
+	 * is untouched: backgrounds/cursor/selection still use whole cells,
+	 * and the pen snaps back to run_start + nvc cells at the run end. */
+	/* Justify the run to its nvc cells. Arabic in its own font is
+	 * narrower than the grid (joined forms, the lam-alef ligature), and
+	 * the slack used to pile up at the run end ('السلام عليكم   ').
+	 * Spread it the Arabic way: kashida (tatweel U+0640 strokes) at the
+	 * cursive joins, then wider word spaces, then centre the rest.
+	 * Extra per join is capped (4 tatweels, 2 cells), so specbuf (8
+	 * per cell) holds base + 3 marks + tatweels. */
+	{
+	float pen = *pxp, run_start = *pxp, natural = 0, slack, per, lead = 0;
+	float *extra = xmalloc(nvc * sizeof(*extra));
+	unsigned char *isjoin = xmalloc(nvc);
+	int npts = 0, nsp = 0;
+
+	for (j = 0; j < nvc; j++) {
+		extra[j] = 0;
+		isjoin[j] = 0;
+		if (merged[j])
+			continue;
+		for (t = 0; t < celln[j]; t++)
+			natural += celladv[j * XSHAPE_MAXG + t] / 64.0f;
+	}
+	slack = nvc * runewidth - natural;
+	if (slack >= 1) {
+		/* visual j (logical l0-j) joins its right neighbour j2 (the
+		 * logically preceding letter); ligature partners have no
+		 * glyphs of their own and are skipped */
+		for (j = 0; j < nvc; j++) {
+			int j2;
+			if (merged[j] || !celln[j])
+				continue;
+			if (glyphs[v2l[v0 + j]].u == ' ')
+				nsp++;
+			for (j2 = j + 1; j2 < nvc && merged[j2]; j2++)
+				;
+			if (j2 == nvc || !celln[j2] ||
+			    cellgfont[j * XSHAPE_MAXG] != cellgfont[j2 * XSHAPE_MAXG])
+				continue;
+			/* a = visual j2 (logically first), p = the cell right of a */
+			{
+				int j3;
+				for (j3 = j2 + 1; j3 < nvc && merged[j3]; j3++)
+					;
+				if (!xkashidaok(j3 < nvc ? glyphs[v2l[v0 + j3]].u : 0,
+				    glyphs[v2l[v0 + j2]].u, glyphs[v2l[v0 + j]].u))
+					continue;
+			}
+			isjoin[j] = 1;
+			npts++;
+		}
+		per = npts ? slack / npts : 0;
+		for (j = 0; j < nvc && npts; j++) {
+			FT_UInt tg;
+			XGlyphInfo ext;
+			if (!isjoin[j])
+				continue;
+			xf = cellgfont[j * XSHAPE_MAXG];
+			tg = XftCharIndex(xw.dpy, xf, 0x0640);
+			if (!tg) {
+				isjoin[j] = 0;
+				continue;
+			}
+			XftGlyphExtents(xw.dpy, xf, &tg, 1, &ext);
+			if (ext.xOff <= 0) {
+				isjoin[j] = 0;
+				continue;
+			}
+			extra[j] = MIN(per, MIN(4.0f * ext.xOff, 2 * runewidth));
+			slack -= extra[j];
+		}
+		if (slack >= 1 && nsp) {
+			per = slack / nsp;
+			for (j = 0; j < nvc; j++) {
+				if (!merged[j] && celln[j] &&
+				    glyphs[v2l[v0 + j]].u == ' ') {
+					extra[j] += per;
+					slack -= per;
+				}
+			}
+		}
+		if (slack >= 1)
+			lead = slack / 2;
+	}
+	pen += lead;
+
+	for (j = 0; j < nvc; j++) {
+		int l = v2l[v0 + j];
+		if (merged[j]) {
+			cnt[v0 + j] = 0;
+			wdt[v0 + j] = 0;
+			continue;
+		}
+		for (t = 0; t < celln[j]; t++) {
+			int si = j * XSHAPE_MAXG + t;
+			specs[*pnum].font = cellgfont[si];
+			specs[*pnum].glyph = cellgid[si];
+			specs[*pnum].x = (short)(pen + celloffx[si] / 64.0f);
+			specs[*pnum].y = (short)(yp - celloffy[si] / 64.0f);
+			(*pnum)++;
+			pen += celladv[si] / 64.0f;
+		}
+		cnt[v0 + j] = celln[j];
+		if (isjoin[j] && extra[j] >= 1) {
+			/* bridge the stretched join with overlapping tatweels */
+			FT_UInt tg;
+			XGlyphInfo ext;
+			int n, i;
+			float step;
+			xf = cellgfont[j * XSHAPE_MAXG];
+			tg = XftCharIndex(xw.dpy, xf, 0x0640);
+			XftGlyphExtents(xw.dpy, xf, &tg, 1, &ext);
+			n = MIN(4, (int)ceilf(extra[j] / ext.xOff));
+			step = n > 1 ? (extra[j] - ext.xOff) / (n - 1) : 0;
+			for (i = 0; i < n; i++) {
+				float x = n > 1 ? pen + i * step
+				                : pen + (extra[j] - ext.xOff) / 2;
+				specs[*pnum].font = xf;
+				specs[*pnum].glyph = tg;
+				specs[*pnum].x = (short)x;
+				specs[*pnum].y = (short)yp;
+				(*pnum)++;
+			}
+			cnt[v0 + j] += n;
+		}
+		pen += extra[j];
+		if (xiscomb(glyphs[l].u)) {
+			wdt[v0 + j] = 0; /* stray mark: overlay, no grid advance */
+		} else {
+			wdt[v0 + j] = wide;
+		}
+	}
+	*pxp = run_start + nvc * runewidth;
+	free(extra);
+	free(isjoin);
+	}
+
+	free(linp);
+	free(lcomb);
+	free(lfont);
+	free(vfont);
+	free(cellgid);
+	free(cellgfont);
+	free(celln);
+	free(merged);
+	free(celladv);
+	free(celloffx);
+	free(celloffy);
+	return nvc;
