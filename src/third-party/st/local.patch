+/*
+ * Bidi + Arabic shaping, display-only.
+ *
+ * The grid buffer stays in logical order (tputc, selection, clipboard and
+ * the cursor are untouched). Each row is reordered to visual order with
+ * FriBidi and Arabic runs are shaped with HarfBuzz at draw time.
+ *
+ * Limitations, stated honestly:
+ * - shaping splits at attribute boundaries (same caveat as the upstream
+ *   ligatures patch): joins break across colors, so zsh syntax-highlighted
+ *   input lines may look fragmented while command output (one color) is
+ *   fully joined. Nothing to fix in st: the shell writes those colors.
+ * - one row == one paragraph; logical lines wrapped over several rows
+ *   (ATTR_WRAP) reorder per row, not per paragraph.
+ * - RTL runs render with shaped (proportional) advances for correct joins
+ *   and natural spaces, then the pen snaps back to the grid at the run
+ *   end. Backgrounds, cursor and selection stay on whole cells.
+ * - harakat ride on their base via shaped offsets (zero grid advance).
+ * - fullscreen apps (vim/tmux) usually want bidi_enabled = 0.
+ */
+
+static int
+xiscomb(Rune u)
+{
+	return (u >= 0x0300 && u <= 0x036f) || (u >= 0x064b && u <= 0x0655) ||
+	    u == 0x0670 || (u >= 0x20d0 && u <= 0x20ff) ||
+	    (u >= 0xfe00 && u <= 0xfe0f) || (u >= 0xfe20 && u <= 0xfe2f);
+}
+
+/* plausible RTL codepoint: gates the (costly) FriBidi path */
+static int
+xisrtl(Rune u)
+{
+	return (u >= 0x0590 && u <= 0x08ff) || (u >= 0xfb1d && u <= 0xfdff) ||
+	    (u >= 0xfe70 && u <= 0xfefc) || u == 0x200e || u == 0x200f;
+}
+
+static FriBidiParType
+xparbase(void)
+{
+	if (bidi_base && bidi_base[0] == 'l')
+		return FRIBIDI_PAR_LTR;
+	if (bidi_base && bidi_base[0] == 'r')
+		return FRIBIDI_PAR_RTL;
+	return FRIBIDI_PAR_ON; /* "auto" */
+}
+
+/* visual -> logical map + embedding levels; identity on LTR-only lines */
+static void
+xbidiorder(const Glyph *glyphs, int len, int *v2l, FriBidiLevel *levels)
+{
+	int i;
+	FriBidiChar *log;
+	FriBidiParType base;
+
+	for (i = 0; i < len; i++) {
+		v2l[i] = i;
+		levels[i] = 0;
+	}
+	if (!bidi_enabled || len <= 0)
+		return;
+	for (i = 0; i < len; i++)
+		if (glyphs[i].mode != ATTR_WDUMMY && xisrtl(glyphs[i].u))
+			break;
+	if (i >= len)
+		return;
+	log = xmalloc(len * sizeof(*log));
+	for (i = 0; i < len; i++)
+		log[i] = (glyphs[i].mode == ATTR_WDUMMY) ? 0x20 : glyphs[i].u;
+	base = xparbase();
+	if (!fribidi_log2vis(log, len, &base, NULL, NULL, v2l, levels)) {
+		for (i = 0; i < len; i++) {
+			v2l[i] = i;
+			levels[i] = 0;
+		}
+	}
+	free(log);
+}
+
+/* mirror brackets etc. when the cell sits at an odd embedding level */
+static Rune
+xmirror(Rune u, FriBidiLevel lvl)
+{
+	FriBidiChar m;
+
+	if ((lvl & 1) && fribidi_get_mirror_char(u, &m))
+		return m;
+	return u;
+}
