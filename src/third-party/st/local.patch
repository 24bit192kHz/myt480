+/* spawn a new st in the shell's current directory (newterm patch) */
+void
+newterm(const Arg* a)
+{
+	char exe[PATH_MAX];
+	ssize_t n;
+	pid_t p;
+
+	switch ((p = fork())) {
+	case -1:
+		die("fork failed: %s\n", strerror(errno));
+		break;
+	case 0:
+		switch (fork()) {
+		case -1:
+			fprintf(stderr, "fork failed: %s\n", strerror(errno));
+			_exit(1);
+			break;
+		case 0:
+			chdir_by_pid(pid);
+			/* exec the resolved path so the process is named st,
+			 * not exe (pkill/pgrep/swallow match on it) */
+			if ((n = readlink("/proc/self/exe", exe, sizeof(exe) - 1)) > 0) {
+				exe[n] = '\0';
+				execl(exe, argv0, NULL);
+			}
+			execlp(argv0, argv0, NULL);
+			_exit(1);
+			break;
+		default:
+			_exit(0);
+		}
+	default:
+		waitpid(p, NULL, 0);
+	}
+}
+
+static int
+chdir_by_pid(pid_t pid)
+{
+	char buf[32];
+	snprintf(buf, sizeof buf, "/proc/%ld/cwd", (long)pid);
+	return chdir(buf);
+}
