+void
+kscrollup(const Arg* a)
+{
+	int n = a->i;
+
+	if (n < 0)
+		n = term.row + n;
+
+	n = MIN(n, term.histn - term.scr);
+	if (n > 0) {
+		term.scr += n;
+		selscroll(0, n);
+		tfulldirt();
+	}
+}
