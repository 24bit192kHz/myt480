+/*
+ * Combining marks stored with their base cell (Glyph.comb, two 8-bit
+ * codes). Covers Arabic harakat + Quranic marks, Hebrew points and the
+ * common Latin/general combining blocks; anything else is still dropped.
+ */
+static const struct { Rune lo, hi; } combrange[] = {
+	{ 0x064b, 0x065f }, { 0x0670, 0x0670 }, { 0x06d6, 0x06ed },
+	{ 0x0300, 0x036f }, { 0x20d0, 0x20f0 }, { 0x0591, 0x05c7 },
+};
+
+static int
+combenc(Rune u)
+{
+	int i, base = 1;
+
+	for (i = 0; i < LEN(combrange); i++) {
+		if (u >= combrange[i].lo && u <= combrange[i].hi)
+			return base + (u - combrange[i].lo);
+		base += combrange[i].hi - combrange[i].lo + 1;
+	}
+	return 0;
+}
+
+static Rune
+combdec(int c)
+{
+	int i, base = 1;
+
+	for (i = 0; c && i < LEN(combrange); i++) {
+		int n = combrange[i].hi - combrange[i].lo + 1;
+		if (c < base + n)
+			return combrange[i].lo + (c - base);
+		base += n;
+	}
+	return 0;
+}
+
+/* marks of g in input order into out[0..1]; returns how many */
+int
+combmarks(const Glyph *g, Rune *out)
+{
+	int n = 0;
+
+	if (g->mode & ATTR_IMAGE)
+		return 0;
+	if (g->comb & 0xff)
+		out[n++] = combdec(g->comb & 0xff);
+	if (g->comb >> 8)
+		out[n++] = combdec(g->comb >> 8);
+	return n;
+}
