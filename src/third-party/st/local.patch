+/*
+ * Draw one maximal visual RTL run starting at visual cell v0 (same mode,
+ * odd levels, logically contiguous). Fills specs/cnt/wdt, advances *pxp.
+ * Returns visual cells consumed. cnt[v] = specs emitted for cell v,
+ * wdt[v] = grid columns consumed (marks: 0, ligature partners: blank 1).
+ */
+static int
+xshapertl(XftGlyphFontSpec *specs, int *pnum, float *pxp, float yp,
+	Font *font, int frcflags, float runewidth,
+	const Glyph *glyphs, int len, const int *v2l, const FriBidiLevel *levels,
+	int v0, int *cnt, int *wdt)
+{
+	int j, k, t, nvc, l0, nglyphs;
+	ushort mode0;
+	FriBidiChar *linp;
+	ushort *lcomb;
+	XftFont **lfont, **vfont, *xf;
+	FT_UInt *cellgid;
+	XftFont **cellgfont;
+	unsigned char *celln, *merged;
+	hb_glyph_info_t *infos;
+	hb_glyph_position_t *pos;
+	int *celladv, *celloffx, *celloffy; /* 26.6 px from HarfBuzz */
+	int wide;
+
+	l0 = v2l[v0];
+	mode0 = glyphs[l0].mode;
+	for (nvc = 0; v0 + nvc < len; nvc++) {
+		int l = v2l[v0 + nvc];
+		if (glyphs[l].mode == ATTR_WDUMMY ||
+		    glyphs[l].mode != mode0 || !(levels[l] & 1) ||
+		    l != l0 - nvc)
+			break;
+	}
+	wide = (mode0 & ATTR_WIDE) ? 2 : 1;
+
+	linp = xmalloc(nvc * sizeof(*linp));
+	lcomb = xmalloc(nvc * sizeof(*lcomb));
+	lfont = xmalloc(nvc * sizeof(*lfont));
+	vfont = xmalloc(nvc * sizeof(*vfont));
+	cellgid = xmalloc(nvc * XSHAPE_MAXG * sizeof(*cellgid));
+	cellgfont = xmalloc(nvc * XSHAPE_MAXG * sizeof(*cellgfont));
+	celln = xmalloc(nvc * sizeof(*celln));
+	merged = xmalloc(nvc * sizeof(*merged));
+	celladv = xmalloc(nvc * XSHAPE_MAXG * sizeof(*celladv));
+	celloffx = xmalloc(nvc * XSHAPE_MAXG * sizeof(*celloffx));
+	celloffy = xmalloc(nvc * XSHAPE_MAXG * sizeof(*celloffy));
+
+	/* logical ascending input (mirrored) + per-cell fonts */
+	for (k = 0; k < nvc; k++) {
+		int l = l0 - nvc + 1 + k;
+		linp[k] = xmirror(glyphs[l].u, levels[l]);
+		lcomb[k] = glyphs[l].comb;
+		lfont[k] = xgetfont(font, linp[k], frcflags);
+	}
+	/* spaces inside RTL runs take the neighboring Arabic font: Meslo's
+	 * space is a full cell (0.60em), the Arabic font's is print-natural
+	 * (~0.24em). Without this, words drift apart. Grid is unaffected:
+	 * the pen still snaps back at the run end. */
