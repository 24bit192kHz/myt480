+/*
+ * Synchronized updates (appsync patch, extended with mode 2026):
+ * between BSU and ESU the frontend does not draw, so apps (tmux, nvim)
+ * never show half-drawn frames. BSU/ESU are CSI ? 2026 h/l or the older
+ * DCS = 1 s / DCS = 2 s. A missing ESU is dropped after su_timeout ms.
+ */
+static int su = 0;
+static struct timespec sutv;
+static int twrite_aborted = 0;
+
+static void
+tsync_begin(void)
+{
+	clock_gettime(CLOCK_MONOTONIC, &sutv);
+	su = 1;
+}
+
+static void
+tsync_end(void)
+{
+	su = 0;
+}
+
+int
+tinsync(uint timeout)
+{
+	struct timespec now;
+
+	if (su && !clock_gettime(CLOCK_MONOTONIC, &now)
+	       && TIMEDIFF(now, sutv) >= timeout)
+		su = 0;
+	return su;
+}
