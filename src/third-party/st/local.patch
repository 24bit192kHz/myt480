+/*
+ * Run argv detached: the intermediate child exits at once, so the command
+ * is reparented to init and never lingers as a zombie of st. With pipefd,
+ * the command's stdin is a pipe whose write end is returned there.
+ */
+static int
+spawn(char *const argv[], int *pipefd)
+{
+	int to[2];
+	pid_t p;
+
+	if (pipefd && pipe(to) == -1)
+		return -1;
+	if ((p = fork()) == -1) {
+		if (pipefd) {
+			close(to[0]);
+			close(to[1]);
+		}
+		return -1;
+	}
+	if (p == 0) {
+		if (fork() == 0) {
+			if (pipefd) {
+				dup2(to[0], STDIN_FILENO);
+				close(to[0]);
+				close(to[1]);
+			}
+			execvp(argv[0], argv);
+			fprintf(stderr, "st: execvp %s: %s\n", argv[0],
+			        strerror(errno));
+			_exit(1);
+		}
+		_exit(0);
+	}
+	if (pipefd) {
+		close(to[0]);
+		*pipefd = to[1];
+	}
+	waitpid(p, NULL, 0);
+	return 0;
+}
