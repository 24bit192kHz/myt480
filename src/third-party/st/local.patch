+		int d;
+		XftFont *nf;
+		if (linp[k] != 0x20)
+			continue;
+		nf = NULL;
+		for (d = 1; d < nvc && !nf; d++) {
+			if (k - d >= 0 && linp[k - d] != 0x20)
+				nf = lfont[k - d];
+			else if (k + d < nvc && linp[k + d] != 0x20)
+				nf = lfont[k + d];
+		}
+		if (nf)
+			lfont[k] = nf;
+	}
+	for (j = 0; j < nvc; j++) {
+		celln[j] = 0;
+		merged[j] = 0;
+		vfont[j] = lfont[nvc - 1 - j];
+	}
+
+	/* shape same-font visual groups (== logical groups, reversed) */
+	for (j = 0; j < nvc;) {
+		int a = j, b, ka;
+		while (j < nvc && vfont[j] == vfont[a])
+			j++;
+		b = j;
+		ka = nvc - b; /* logical start of group */
+		xf = vfont[a];
+		infos = xshaperun(xf, &linp[ka], &lcomb[ka], b - a, 1, &nglyphs, &pos);
+		if (infos) {
+			for (t = 0; t < nglyphs; t++) {
+				int cc = (int)infos[t].cluster;
+				int jj;
+				if (cc < 0 || cc >= b - a)
+					continue;
+				jj = nvc - 1 - (ka + cc);
+				if (infos[t].codepoint == 0)
+					continue; /* no .notdef boxes from shaping */
+				if (celln[jj] < XSHAPE_MAXG) {
+					int si = jj * XSHAPE_MAXG + celln[jj];
+					cellgid[si] = infos[t].codepoint;
+					cellgfont[si] = xf;
+					celladv[si] = pos[t].x_advance;
+					celloffx[si] = pos[t].x_offset;
+					celloffy[si] = pos[t].y_offset;
+					celln[jj]++;
+				}
+			}
+			free(infos);
+			free(pos);
+		} else {
+			/* HarfBuzz failed: unshaped cells, text never lost.
+			 * Grid advance as fallback so columns stay aligned. */
+			for (t = a; t < b; t++) {
+				int l = v2l[v0 + t];
+				Rune r = xmirror(glyphs[l].u, levels[l]);
+				int si = t * XSHAPE_MAXG + celln[t];
+				cellgid[si] = XftCharIndex(xw.dpy, xf, r);
+				cellgfont[si] = xf;
+				celladv[si] = (int)(runewidth * 64);
+				celloffx[si] = 0;
+				celloffy[si] = 0;
+				celln[t]++;
+			}
+		}
+	}
+
+	/* harakat: combining-only cells merge into previous visual cell,
+	 * carrying their shaped offsets so marks ride on the base. */
