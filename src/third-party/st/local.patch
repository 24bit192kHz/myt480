+/*
+ * Shape one HarfBuzz run (logical order). Returns malloc'd glyph infos in
+ * visual order (free with free()), *nglyphs set, *outpos gets the malloc'd
+ * positions (26.6 pixels, free with free()), NULL on failure so the
+ * caller can fall back to unshaped cells. hb objects live per call, so
+ * zoom font reloads need no cache invalidation.
+ */
+static hb_glyph_info_t *
+xshaperun(XftFont *xfont, const FriBidiChar *run, const ushort *comb,
+	int runlen, int rtl, int *nglyphs, hb_glyph_position_t **outpos)
+{
+	FT_Face face;
+	hb_font_t *hbfont;
+	hb_buffer_t *buf;
+	const hb_glyph_info_t *infos;
+	const hb_glyph_position_t *pos;
+	hb_glyph_info_t *out = NULL;
+	unsigned int n = 0;
+	int i, arabic = 0, hebrew = 0;
+
+	*nglyphs = 0;
+	*outpos = NULL;
+	for (i = 0; i < runlen; i++) {
+		if ((run[i] >= 0x0600 && run[i] <= 0x08ff) ||
+		    (run[i] >= 0xfb50 && run[i] <= 0xfeff))
+			arabic = 1;
+		else if (run[i] >= 0x0590 && run[i] <= 0x05ff)
+			hebrew = 1;
+	}
+
+	face = XftLockFace(xfont);
+	if (!face)
+		return NULL;
+	hbfont = hb_ft_font_create(face, NULL);
+	buf = hb_buffer_create();
+	/* one cluster per cell: its base, then its stored combining marks,
+	 * so HarfBuzz attaches the marks (GPOS) and keeps them in that cell */
+	hb_buffer_set_content_type(buf, HB_BUFFER_CONTENT_TYPE_UNICODE);
+	for (i = 0; i < runlen; i++) {
+		Glyph g = { .comb = comb ? comb[i] : 0 };
+		Rune m[2];
+		int k, nm = combmarks(&g, m);
+		hb_buffer_add(buf, run[i], i);
+		for (k = 0; k < nm; k++)
+			hb_buffer_add(buf, m[k], i);
+	}
+	hb_buffer_set_direction(buf, rtl ? HB_DIRECTION_RTL : HB_DIRECTION_LTR);
+	if (arabic || hebrew)
+		hb_buffer_set_script(buf, arabic ? HB_SCRIPT_ARABIC : HB_SCRIPT_HEBREW);
+	if (arabic)
+		hb_buffer_set_language(buf, hb_language_from_string("ar", -1));
+	hb_buffer_guess_segment_properties(buf);
+	hb_shape(hbfont, buf, NULL, 0);
+	infos = hb_buffer_get_glyph_infos(buf, &n);
+	pos = hb_buffer_get_glyph_positions(buf, &n);
+	if (n > 0) {
+		out = xmalloc(n * sizeof(*out));
+		memcpy(out, infos, n * sizeof(*out));
+		*outpos = xmalloc(n * sizeof(**outpos));
+		memcpy(*outpos, pos, n * sizeof(**outpos));
+		*nglyphs = n;
+	}
+	hb_buffer_destroy(buf);
+	hb_font_destroy(hbfont);
+	XftUnlockFace(xfont);
+	return out;
+}
+
+/* max shaped glyphs kept per cell (base + marks); extras are dropped */
+#define XSHAPE_MAXG 4
+
+/* a (logically first) joins b (next) and the join may be stretched
+ * with kashida. Never inside lam-alef (fonts such as IBM Plex draw it
+ * as two contextual glyphs, a tatweel between them breaks it) or the
+ * lam-lam(-heh) of Allah; p is the letter before a, or 0. */
+static int
+xkashidaok(Rune p, Rune a, Rune b)
+{
+	if (a == 0x0644) {
+		switch (b) {
+		case 0x0622: case 0x0623: case 0x0625: case 0x0627:
+		case 0x0671: case 0x0672: case 0x0673: case 0x0675:
+		case 0x0644:
+			return 0;
+		case 0x0647:
+			if (p == 0x0644)
+				return 0;
+		}
+	}
+	return FRIBIDI_JOINS_LEFT(fribidi_get_joining_type(a)) &&
+	       FRIBIDI_JOINS_RIGHT(fribidi_get_joining_type(b));
+}
