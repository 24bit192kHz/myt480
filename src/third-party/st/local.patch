+/* one row as UTF-8, blank tail trimmed; soft-wrapped rows get no newline */
+static int
+twriterow(int fd, const Glyph *gp)
+{
+	char buf[UTF_SIZ];
+	int x, len = term.col, wrap = gp[term.col - 1].mode & ATTR_WRAP;
+	Rune u;
+
+	if (!wrap)
+		while (len > 0 && gp[len - 1].u == ' ')
+			len--;
+	for (x = 0; x < len; x++) {
+		if (gp[x].mode & ATTR_WDUMMY)
+			continue;
+		u = (gp[x].mode & ATTR_IMAGE || !gp[x].u) ? ' ' : gp[x].u;
+		if (xwrite(fd, buf, utf8encode(u, buf)) < 0)
+			return -1;
+		{
+			Rune m[2];
+			int k, nm = combmarks(&gp[x], m);
+			for (k = 0; k < nm; k++)
+				if (xwrite(fd, buf, utf8encode(m[k], buf)) < 0)
+					return -1;
+		}
+	}
+	return wrap ? 0 : xwrite(fd, "\n", 1);
+}
