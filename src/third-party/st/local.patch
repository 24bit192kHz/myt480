+/* pipe the screen (and optionally the history before it) to a command */
+static void
+tpipe(const Arg *arg, int withhist)
+{
+	/* in the alt screen the history belongs to the saved main screen */
+	Line *scr = (withhist && IS_SET(MODE_ALTSCREEN)) ? term.alt : term.line;
+	void (*oldsigpipe)(int);
+	int fd, k, x, y, last;
+
+	if (spawn((char *const *)arg->v, &fd) < 0)
+		return;
+	/* ignore SIGPIPE in case the command exits early */
+	oldsigpipe = signal(SIGPIPE, SIG_IGN);
+	if (withhist) {
+		for (k = term.histn - 1; k >= 0; k--) {
+			if (twriterow(fd, term.hist[(term.histi - k + HISTSIZE)
+			                            % HISTSIZE]) < 0)
+				goto done;
+		}
+	}
+	for (last = term.row - 1; last > 0; last--) {
+		for (x = 0; x < term.col && scr[last][x].u == ' '; x++)
+			;
+		if (x < term.col)
+			break;
+	}
+	for (y = 0; y <= last; y++)
+		if (twriterow(fd, scr[y]) < 0)
+			break;
+done:
+	close(fd);
+	signal(SIGPIPE, oldsigpipe);
+}
