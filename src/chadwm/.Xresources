! GENERATED by theme-sync.sh from theme/palette.conf — do not hand-edit.
Xft.antialias:	1
Xft.hinting:	1
Xft.autohint:	0
Xft.hintstyle:	hintslight
Xft.rgba:	rgb
Xft.lcdfilter:	lcddefault
! window padding
st.borderpx: 20
!-- values between 0.1  - 1.0 --!
st.alpha: 1.0
st.font:           JetBrainsMono Nerd Font:style:medium:pixelsize=15
*foreground:   #e4e4e4
*background:   #1a1a1a
*cursorColor:  #cfcfcf
*color0:       #1a1a1a
*color1:       #cc3333
*color2:       #66aa66
*color3:       #ccaa33
*color4:       #cc3333
*color5:       #aa66aa
*color6:       #66aaaa
*color7:       #aaaaaa
*color8:       #555555
*color9:       #ff6666
*color10:      #88cc88
*color11:      #ffdd55
*color12:      #88bbee
*color13:      #cc88cc
*color14:      #88cccc
*color15:      #ffffff
tabbed.selfgcolor:   #e4e4e4
tabbed.selbgcolor:   #101010
tabbed.normfgcolor:  #6e6e6e
tabbed.normbgcolor:  #1e1e1e
