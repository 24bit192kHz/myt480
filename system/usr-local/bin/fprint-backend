#!/bin/sh
# fprint-backend [libfprint|validity]: show or switch the fingerprint stack.
#   libfprint  fprintd + libfprint-cs9711 (USB Chipsailing CS9711, 2541:0236)
#   validity   open-fprintd + validity-rs (internal Synaptics 06cb:009a)
# The boot db starts neither; the first client bus-activates the chosen one
# through /usr/local/libexec/fprint-activate.
state=/var/lib/fprint-backend
if [ $# -eq 0 ]; then cat "$state" 2>/dev/null || echo libfprint; exit 0; fi
case "$1" in
  libfprint|validity) ;;
  *) echo "usage: fprint-backend [libfprint|validity]" >&2; exit 2 ;;
esac
[ "$(id -u)" = 0 ] || { echo "fprint-backend: run as root" >&2; exit 1; }
printf '%s\n' "$1" > "$state"
if [ "$1" = libfprint ]; then
  s6-rc -d change validity-rs open-fprintd
  # s6-rc can think a service is down while its supervisor still runs it
  # (after a plain s6-svc -u, as the old bus activation did): stop both directly.
  for s in validity-rs open-fprintd; do
    s6-svc -wD -T 5000 -d /run/service/$s 2>/dev/null
  done
else
  pkill -x fprintd
  s6-rc -u change validity-rs
fi
echo "fingerprint stack: $1"
