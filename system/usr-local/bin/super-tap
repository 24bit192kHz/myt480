#!/usr/bin/env python3
"""Super-tap opens Titus launcher (Hyprland SUPER-tap parity for dwm).

Passive XQueryKeymap polling daemon. No key grabs, no XTEST needed:
it never steals or re-injects keys, so dwm's own Super grabs keep working.
Quick Super press+release (under TAP_MS) with no other key down in
between counts as a tap and toggles the quickshell launcher. Any chord
or hold cancels.

SIGUSR1 forces a fire (used to test the launcher path headlessly).
"""
import signal
import subprocess
import sys
import time

TAP_MS = 220
POLL = 0.015
SUPER_CODES = (133, 134)  # Super_L, Super_R (xmodmap on T480)
LAUNCHER = (
    "quickshell ipc --path "
    '"${XDG_CONFIG_HOME:-$HOME/.config}/quickshell/shell.qml" '
    "call launcher toggle"
)


def spawn_launcher():
    subprocess.Popen(
        "pkill -x rofi 2>/dev/null; " + LAUNCHER,
        shell=True,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )


def _sig_fire(*_a):
    spawn_launcher()


def bit_set(keymap, code):
    return bool(keymap[code // 8] & (1 << (code % 8)))


def others_down(keymap):
    masked = bytearray(keymap)
    for code in SUPER_CODES:
        masked[code // 8] &= ~(1 << (code % 8))
    return any(masked)


def main():
    from Xlib import display

    d = display.Display()
    signal.signal(signal.SIGUSR1, _sig_fire)
    state = "idle"
    t0 = 0.0
    while True:
        keymap = bytes(d.query_keymap())
        super_down = any(bit_set(keymap, c) for c in SUPER_CODES)
        now = time.monotonic()
        if state == "idle":
            if super_down:
                state = "held"
                t0 = now
        elif state == "held":
            if others_down(keymap):
                state = "cancel"  # chord in progress, not a tap
            elif not super_down:
                if (now - t0) * 1000 <= TAP_MS:
                    spawn_launcher()
                state = "idle"
            elif (now - t0) * 1000 > 1000:
                state = "cancel"  # long hold, modifier use
        else:  # cancel: wait for full release
            if not super_down:
                state = "idle"
        time.sleep(POLL)


if __name__ == "__main__":
    sys.exit(main())
