#!/bin/sh
# Dynamic hibernate image size: 40% of RAM, clamped 2G..25G.
set -eu
MEMKB=$(awk "/MemTotal/ {print \$2}" /proc/meminfo)
IMG=$((MEMKB * 40 / 100 * 1024))
MIN=$((2 * 1024 * 1024 * 1024))
MAX=$((25 * 1024 * 1024 * 1024))
[ "$IMG" -lt "$MIN" ] && IMG=$MIN
[ "$IMG" -gt "$MAX" ] && IMG=$MAX
echo "$IMG" > /sys/power/image_size
echo 8 > /sys/power/hibernate_compression_threads
logger -t hibernate-tune "image_size=$IMG threads=8"
echo platform > /sys/power/disk
