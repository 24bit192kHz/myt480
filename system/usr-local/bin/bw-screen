#!/usr/bin/env python3
"""bw-screen: tell Bitwarden desktop about the screen lock (bitwarden-slock).

  bw-screen lock     lock all Bitwarden vaults (no-op when Bitwarden is not running)
  bw-screen unlock   the screen was just unlocked: Bitwarden unlocks via polkit,
                     which grants it once right after slock (no second prompt)
  bw-screen boot     session start: wait for the boot lock to go away, start
                     Bitwarden in the tray if needed, then unlock it

Talks to $XDG_RUNTIME_DIR/bitwarden-screen.sock (patched Bitwarden, see
~/build/bitwarden-bin/bitwarden-slock.py).
"""
import os
import socket
import subprocess
import sys
import time

RUNDIR = os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}"
SOCK = os.path.join(RUNDIR, "bitwarden-screen.sock")


def send(word, timeout=3.0):
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.settimeout(timeout)
    try:
        s.connect(SOCK)
        s.sendall(word.encode())
        s.shutdown(socket.SHUT_WR)
        return s.recv(64).decode().strip() == "ok"
    except OSError:
        return False
    finally:
        s.close()


def locked():
    locker = os.environ.get("BW_SCREEN_LOCKER", "slock")
    return subprocess.run(["pgrep", "-x", locker], stdout=subprocess.DEVNULL).returncode == 0


def boot():
    # the boot lock comes up before the session bus and the keyring are
    # ready; Bitwarden starts only once the user is in
    while locked():
        time.sleep(0.25)
    if not send("ping"):
        # --autostart + "run in background" = straight to the tray.
        # Through igpu-run (Intel/Mesa only): Electron otherwise probes the NVIDIA EGL and
        # Vulkan drivers, opens /dev/nvidiactl and keeps the MX150 in D0 all session long
        # (seen 2026-10-09; the desktop file is not used by this autostart path).
        igpu = "/usr/local/bin/igpu-run"
        launcher = [igpu] if os.access(igpu, os.X_OK) else []
        subprocess.Popen(launcher + ["bitwarden", "--autostart"], stdin=subprocess.DEVNULL,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         start_new_session=True)
        for _ in range(120):
            if os.path.exists(SOCK) and send("ping", 1.0):
                break
            time.sleep(0.25)
    return send("unlock")


def main():
    cmd = sys.argv[1] if len(sys.argv) == 2 else ""
    if cmd in ("lock", "unlock"):
        return 0 if send(cmd) else 1
    if cmd == "boot":
        return 0 if boot() else 1
    print(__doc__.strip(), file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main())
