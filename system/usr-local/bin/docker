#!/bin/sh
# Docker is not started at boot (s6: docker-srv usable, not active).
# First use starts it (containerd is pulled in as a dependency).
if ! [ -S /run/docker.sock ] || ! pgrep -x dockerd >/dev/null; then
	sudo -n /usr/bin/s6 live start docker-srv >/dev/null 2>&1
	i=0
	while ! [ -S /run/docker.sock ] && [ $i -lt 150 ]; do sleep 0.1; i=$((i+1)); done
fi
exec /usr/bin/docker "$@"
