# Overrides /usr/share/dbus-1/system-services/net.reactivated.Fprint.service.
# fprint-activate starts the stack chosen with fprint-backend: fprintd itself
# (libfprint, CS9711) or the s6-supervised open-fprintd + validity-rs.
[D-BUS Service]
Name=net.reactivated.Fprint
Exec=/usr/local/libexec/fprint-activate
User=root
