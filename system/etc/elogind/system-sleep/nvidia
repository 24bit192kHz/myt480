#!/bin/sh
# Source-only snapshot of the observed T480 hook, with truthful status reporting.
# The observed /usr/lib and /usr/libexec vendor hooks were absent. Verify effective
# elogind hook precedence and NVIDIA ownership before any later deployment.
# Returning failure reports this hook's result; elogind may still continue sleep.
# No package configuration is changed by storing this file in the repository.
#
# elogind: $2 = suspend | hibernate | hybrid-sleep | suspend-then-hibernate.
# SYSTEMD_SLEEP_ACTION identifies the suspend-then-hibernate phase. Preserve the
# observed hibernate dispatch and synchronous, 30-second resume timeout.
case "$2" in
	hibernate|hybrid-sleep) act=hibernate ;;
	suspend-then-hibernate) act=${SYSTEMD_SLEEP_ACTION:-suspend} ;;
	*) act=suspend ;;
esac

log()
{
	# Logging failure must not replace a helper/timeout failure or success status.
	logger -t nvidia-sleep "$*" || :
}

VTF=/var/run/nvidia-sleep/Xorg.vt_number
case "$1" in
	pre)
		# Keep the observed unloaded-driver behavior: no NVIDIA helper call.
		[ -e /proc/driver/nvidia/suspend ] || exit 0
		log "pre $2: $act"
		/usr/bin/nvidia-sleep.sh "$act"
		rc=$?
		if [ "$rc" -ne 0 ]; then
			log "pre $2: $act failed (rc $rc)"
		fi
		exit "$rc"
		;;
	post)
		[ -e /proc/driver/nvidia/suspend ] || exit 0
		timeout 30 /usr/bin/nvidia-sleep.sh resume
		rc=$?
		if [ "$rc" -ne 0 ]; then
			if [ "$rc" -eq 124 ]; then
				# GNU timeout and a helper itself can both return 124.
				log "post $2: resume failed or timed out (30 s limit; rc $rc)"
			else
				log "post $2: resume failed (rc $rc)"
			fi
			# Preserve the observed fallback: consume the saved VT and restore it
			# after a failed/timed-out resume. Cleanup must not mask the resume rc.
			if [ -f "$VTF" ]; then
				vt=$(cat "$VTF")
				rm -f "$VTF"
				chvt "$vt" 2>/dev/null
				vt_rc=$?
				if [ "$vt_rc" -ne 0 ]; then
					log "post $2: VT restore failed (rc $vt_rc); resume rc $rc"
				fi
			fi
		fi
		exit "$rc"
		;;
esac
exit 0
