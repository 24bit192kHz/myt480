#!/bin/bash
# WinApps VM around sleep (elogind hook: $1=pre|post, $2=verb, SYSTEMD_SLEEP_ACTION=current phase;
# suspend-then-hibernate runs the hooks once per phase).
#   no Windows app open -> clean shutdown before any sleep (its 8 GB never reaches swap or the
#                          hibernation image); after wake boot it in the background and pause it
#                          once Windows is up, so the next launch is instant (`winapps` unpauses)
#   apps open, suspend  -> pause, and unpause right after wake so the app windows reconnect
#   apps open, hibernate-> left alone: shutting down would lose unsaved work
COMPOSE=/home/btw/.config/winapps/compose.yaml
BOOT=/run/winapps-sleep.boot       # "boot it after wake" (tmpfs: survives hibernate, not reboot)
PAUSED=/run/winapps-sleep.paused   # we paused it with apps open; unpause on wake
ASLEEP=/run/winapps-sleep.asleep   # a sleep is in progress; a pending boot must wait
LOG=/var/log/winapps-sleep.log
phase="${SYSTEMD_SLEEP_ACTION:-$2}"
# /usr/bin/docker, not the /usr/local/bin wrapper: a sleep hook must never start dockerd.
PATH=/usr/bin:/bin:/usr/sbin
[ -S /run/docker.sock ] && pgrep -x dockerd >/dev/null || exit 0

state() { docker inspect -f "{{.State.Status}}" WinApps 2>/dev/null; }
dc() { docker compose -f "$COMPOSE" "$@" >/dev/null 2>&1; }
log() { echo "$(date "+%F %T") $*" >>"$LOG"; }
apps_open() { pgrep -x xfreerdp3 >/dev/null || pgrep -x sdl-freerdp3 >/dev/null; }

boot_and_park() {
    # s2h wakes on its timer only to hibernate right after; give that pre hook the chance to run.
    exec 8>/run/winapps-sleep.lock; flock -n 8 || return
    sleep 15
    [ -e "$ASLEEP" ] && { log "boot: sleep in progress, deferring to next wake"; return; }
    rm -f "$BOOT"
    [ "$(state)" = exited ] || { log "boot: VM is $(state), leaving it"; return; }
    dc start || { log "boot: start failed"; return; }
    t=0   # RDP up, then the boot burst settles (container < 15% of a core twice in a row)
    until timeout 1 bash -c "</dev/tcp/127.0.0.1/3389" 2>/dev/null; do sleep 2; t=$((t + 2)); [ $t -ge 180 ] && break; done
    calm=0
    while [ $t -lt 300 ] && [ $calm -lt 2 ]; do
        cpu=$(docker stats --no-stream --format "{{.CPUPerc}}" WinApps | tr -d "%")
        if [ "${cpu%.*}" -lt 15 ] 2>/dev/null; then calm=$((calm + 1)); else calm=0; fi
        sleep 5; t=$((t + 7))
    done
    [ -e "$ASLEEP" ] && { log "boot: sleep started while booting"; return; }
    if apps_open; then log "boot: up after ${t}s, an app is open, not pausing"
    elif [ "$(state)" = running ]; then dc pause && log "boot: up after ${t}s, paused (ready)"; fi
}

case "$1" in
    boot)   # detached copy started by the post hook below
        boot_and_park; exit 0 ;;
    pre)
        touch "$ASLEEP"
        st=$(state)
        case "$st" in running|paused) ;; *) exit 0 ;; esac
        if ! apps_open; then
            [ "$st" = paused ] && dc unpause
            timeout 80 docker stop -t 75 WinApps >/dev/null 2>&1
            touch "$BOOT"; log "pre $phase: no apps open, Windows shut down (now $(state))"
        elif [ "$phase" = suspend ] && [ "$st" = running ]; then
            dc pause && touch "$PAUSED" && log "pre suspend: apps open, paused"
        else
            log "pre $phase: apps open, VM left $st"
        fi ;;
    post)
        rm -f "$ASLEEP"
        if [ -e "$PAUSED" ]; then
            rm -f "$PAUSED"; [ "$(state)" = paused ] && dc unpause && log "post $phase: unpaused for open apps"
        fi
        if [ -e "$BOOT" ]; then
            log "post $phase: booting Windows in background"
            setsid "$0" boot >/dev/null 2>&1 </dev/null &
        fi ;;
esac
exit 0
