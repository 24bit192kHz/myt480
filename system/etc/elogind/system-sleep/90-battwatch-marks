#!/bin/sh
# battwatch: mark the edges of every sleep phase (elogind hook: $1=pre|post, $2=verb).
# Install as root: /etc/elogind/system-sleep/90-battwatch-marks (0755).
#
# suspend-then-hibernate runs the hooks once per phase with SYSTEMD_SLEEP_ACTION
# = suspend, then hibernate; the daemon cannot tick in between and would see one
# gap. It splits that gap with these lines (see crates/battwatch-core/src/marks.rs):
#   <pre|post> <action> <wall s> <BOOTTIME ms> <MONOTONIC ms> BATn=<charge_now|energy_now> ...
# /run is tmpfs: the pre line of a hibernation is in the image, so it survives the resume.
F=/run/battwatch-sleep.marks
case "$1" in pre|post) ;; *) exit 0 ;; esac

read -r up _ </proc/uptime
boot=$(echo "$up" | awk '{ printf "%d", $1 * 1000 }')
mono=$(sed -n 's/^now at \([0-9]*\) nsecs$/\1/p; 3q' /proc/timer_list)
mono=$((${mono:-0} / 1000000))
line="$1 ${SYSTEMD_SLEEP_ACTION:-$2} $(date +%s) $boot $mono"
for b in /sys/class/power_supply/BAT*; do
	[ -e "$b" ] || continue
	q=$(cat "$b/charge_now" 2>/dev/null || cat "$b/energy_now" 2>/dev/null) || continue
	line="$line ${b##*/}=$q"
done

umask 022
[ -f "$F" ] && [ "$(wc -l <"$F")" -gt 400 ] && { tail -n 200 "$F" >"$F.new" && mv "$F.new" "$F"; }
echo "$line" >>"$F"

# A hibernation image can be lost (the next boot is another kernel, or resume
# fails); /run goes with it. Keep this boot's marks on disk until the post line,
# so the daemon can tell that boot change from a crash (marks.rs, lost_hibernation).
P=/var/lib/battwatch/hibernate.pending
case "$1 ${SYSTEMD_SLEEP_ACTION:-$2}" in
"pre hibernate")
	mkdir -p "${P%/*}" &&
		{ echo "boot=$(cat /proc/sys/kernel/random/boot_id)"; cat "$F"; } >"$P.new" &&
		mv "$P.new" "$P" ;;
"post hibernate") rm -f "$P" ;;
esac
exit 0
