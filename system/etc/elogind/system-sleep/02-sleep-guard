#!/bin/sh
# elogind sleep hook: keep a hang in or after a sleep from becoming a dead, lit machine.
#
# 1. TCO watchdog (post, every wake): coreboot's resume path halts the PCH TCO timer
#    (TCO1_CNT TMR_HLT set after S3, measured 2026-10-05), and iTCO_wdt does not stop or
#    restart it for S3/S4 (need_suspend() is false), so the kernel keeps reporting it
#    "active" while the keepalive pets a stopped timer. 2026-10-05 20:22 a hibernate
#    started after an S3 wake hung for 2 h 40 min on battery (no TCO reset, power-button
#    override). Restarting the keepalive closes /dev/watchdog with the magic 'V' and opens
#    it again, which runs iTCO_wdt_start() and clears TMR_HLT.
#    The wake also resets the timeout register (TCOBASE+0x12) to its default of 4 ticks
#    (2.4 s) while the kernel still believes 30 s: un-halting it as it is reset the machine
#    5 s after an RTC wake (SECOND_TO, 2026-10-05 23:16). So the timeout is written again
#    first (wdctl -s: WDIOC_SETTIMEOUT, then magic close), read back from the register, and
#    the keepalive restarts only when it matches; otherwise the watchdog stays disarmed.
# 2. Wake-on-LAN on AC only (pre, every sleep), as Lenovo's "Wake On LAN: AC Only" default:
#    with the GbE armed, its PHY stays powered through S3/S4 on battery for nothing
#    (/proc/acpi/wakeup GLAN). post puts the wake setting back as it was.
# 3. Hibernate (pre): the TCO watchdog is DISARMED first. Every user process, the keepalive
#    included, is frozen while the kernel writes the image, so a hibernate that takes longer
#    than the 30 s timeout ends in a TCO reset (2026-10-08 14:55:33, exactly 30 s after
#    "Performing sleep operation 'hibernate'", TCO2_STS SECOND_TO); the hardware halts the
#    timer in S3 but not before S4. post re-arms it. For a real hang in the transition:
#    hung-task panic at 60 s (a sync or notifier stuck in D state) -> panic=10 reboots.
#    post puts the defaults back. PM debug messages go to the kernel log.
PATH=/usr/bin:/bin:/usr/sbin:/sbin
SAVE=/run/sleep-guard.saved
WOL=/run/sleep-guard.wol-off
WDOFF=/run/sleep-guard.wd-off
GLAN=/sys/bus/pci/devices/0000:00:1f.6/power/wakeup

case "$2" in
	hibernate|hybrid-sleep) act=hibernate ;;
	suspend-then-hibernate) act=${SYSTEMD_SLEEP_ACTION:-suspend} ;;
	*) act=suspend ;;
esac

tco_ticks() { # the TCO timeout register as the hardware has it
	base=$(sed -n 's/^ *\([0-9a-f]*\)-[0-9a-f]* : iTCO_wdt$/\1/p' /proc/ioports | head -n1)
	[ -n "$base" ] || return 1
	dd if=/dev/port bs=1 skip=$((0x$base + 0x12)) count=2 2>/dev/null | od -An -tu2 | tr -d ' '
}

stop_keepalive() { # magic close through the keepalive's own descriptor; 1 if it would not exit
	pid=$(pgrep -o -f 'watchdog-keepalive$') || return 0
	kill -TERM "$pid" 2>/dev/null
	pkill -TERM -P "$pid" -x sleep 2>/dev/null # the trap runs once its sleep returns
	i=0; while kill -0 "$pid" 2>/dev/null && [ $i -lt 70 ]; do sleep 0.1; i=$((i+1)); done
	if kill -0 "$pid" 2>/dev/null; then
		logger -t sleep-guard "keepalive $pid did not exit, watchdog left as it was"
		return 1
	fi
}

force_disarm() { # the loop would not exit: drop it without its magic close, then stop the timer
	# from a fresh descriptor (open, 'V', close = magic close; nowayout is off on this kernel)
	pkill -9 -f 'watchdog-keepalive$' 2>/dev/null
	i=0; while pgrep -f 'watchdog-keepalive$' >/dev/null && [ $i -lt 30 ]; do sleep 0.1; i=$((i+1)); done
	i=0; until printf V >/dev/watchdog0 2>/dev/null || [ $i -ge 20 ]; do sleep 0.1; i=$((i+1)); done
	[ "$(cat /sys/class/watchdog/watchdog0/state 2>/dev/null)" = inactive ]
}

disarm_watchdog() {
	pgrep -f 'watchdog-keepalive$' >/dev/null || return 0 # not armed
	if ! stop_keepalive; then
		logger -t sleep-guard "forcing the TCO disarm before $1"
		force_disarm || { logger -t sleep-guard "TCO watchdog STILL ARMED before $1: an image write over 30 s will reset the machine"; return 1; }
	fi
	touch "$WDOFF"
	logger -t sleep-guard "TCO watchdog disarmed for $1 (the keepalive is frozen while the image is written)"
}

rearm_watchdog() {
	if ! pgrep -f 'watchdog-keepalive$' >/dev/null && [ ! -e "$WDOFF" ]; then
		return 0 # not armed (disarmed by hand)
	fi
	rm -f "$WDOFF"
	stop_keepalive || return 1
	t=$(cat /sys/class/watchdog/watchdog0/timeout 2>/dev/null); t=${t:-30}
	wdctl -s "$t" /dev/watchdog0 >/dev/null 2>&1
	want=$((t * 10 / 6)) have=$(tco_ticks)
	if [ "$have" != "$want" ]; then
		logger -t sleep-guard "TCO timeout register $have ticks, want $want: watchdog left disarmed"
		return 1
	fi
	/etc/local.d/watchdog.start
	i=0; while ! pgrep -f 'watchdog-keepalive$' >/dev/null && [ $i -lt 30 ]; do sleep 0.1; i=$((i+1)); done
	if ! pgrep -f 'watchdog-keepalive$' >/dev/null; then
		logger -t sleep-guard "keepalive did not start after $1: TCO watchdog left disarmed"
		return 1
	fi
	logger -t sleep-guard "TCO watchdog re-armed after $1 (${t} s, $have ticks)"
}

case "$1" in
pre)
	if [ "$(cat /sys/class/power_supply/AC/online 2>/dev/null)" = 0 ] && \
	   [ "$(cat $GLAN 2>/dev/null)" = enabled ]; then
		echo disabled >$GLAN && touch "$WOL"
	fi
	[ "$act" = hibernate ] || exit 0
	disarm_watchdog "$2"
	[ -e "$SAVE" ] || printf '%s %s %s\n' "$(cat /proc/sys/kernel/hung_task_timeout_secs)" \
		"$(cat /proc/sys/kernel/hung_task_panic)" "$(cat /sys/power/pm_debug_messages)" >"$SAVE"
	echo 60 >/proc/sys/kernel/hung_task_timeout_secs
	echo 1 >/proc/sys/kernel/hung_task_panic
	echo 1 >/sys/power/pm_debug_messages ;;
post)
	if [ -e "$WOL" ]; then
		echo enabled >$GLAN; rm -f "$WOL"
	fi
	if [ -s "$SAVE" ]; then
		read -r t p d <"$SAVE"
		echo "$t" >/proc/sys/kernel/hung_task_timeout_secs
		echo "$p" >/proc/sys/kernel/hung_task_panic
		echo "$d" >/sys/power/pm_debug_messages
		rm -f "$SAVE"
	fi
	rearm_watchdog "$2" ;;
esac
exit 0
