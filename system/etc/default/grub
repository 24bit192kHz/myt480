GRUB_DISTRIBUTOR='Artix'
GRUB_CMDLINE_LINUX_DEFAULT='quiet loglevel=0 fbcon=nodefer vt.global_cursor_default=0 printk.devkmsg=off nowatchdog nmi_watchdog=0 rd.udev.log_level=0 8250.nr_uarts=0 iomem=relaxed thinkpad_acpi.force_load=1 thinkpad_acpi.fan_control=1 nvme_core.io_timeout=30 nvme_core.admin_timeout=30 init_on_alloc=0 init_on_free=0 mitigations=off usb-storage.delay_use=0 psmouse.synaptics_intertouch=1 i915.enable_psr=1 i915.enable_fbc=1 nvme_core.default_ps_max_latency_us=5500 resume=UUID=<UUID of the swap partition>'
