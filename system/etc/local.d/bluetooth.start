#!/bin/sh
# Start bluetoothd at boot (no s6 service on this machine; rc-local runs local.d).
# /etc/bluetooth/main.conf AutoEnable=true powers the adapter as soon as the daemon sees it.
rfkill unblock bluetooth 2>/dev/null
pgrep -x bluetoothd > /dev/null || /usr/lib/bluetooth/bluetoothd > /dev/null 2>&1 &
