#!/bin/sh
# Arm the PCH TCO hardware watchdog (iTCO_wdt, 30 s) and pet it every 5 s: a kernel hang
# ends in a reset 30 s later instead of a power-button hold. Run by rc-local at boot,
# before udev has bound lpc_ich, so the detached loop waits for /dev/watchdog itself.
# The loop ignores SIGHUP (it outlives the shell that started it); on TERM/INT it writes
# the magic close 'V' on its own descriptor and exits, which disarms the watchdog. Only a
# kill -9 or a hang leaves it armed. Safe to run again (one loop at most).
modprobe iTCO_wdt 2>/dev/null
pgrep -f "watchdog-keepalive$" > /dev/null && exit 0
setsid sh -c '
trap "" HUP
i=0; while [ ! -c /dev/watchdog ] && [ $i -lt 60 ]; do sleep 1; i=$((i+1)); done
[ -c /dev/watchdog ] || exit 0
trap "printf V >&3; exec 3>&-; exit 0" TERM INT
exec 3> /dev/watchdog
while :; do printf 1 >&3; sleep 5; done' watchdog-keepalive > /dev/null 2>&1 < /dev/null &
