#!/bin/sh
# Unblock wifi at boot only if soft-blocked and NM reachable (no-op fast path).
exec >>/var/log/wifi-unblock.log 2>&1
echo "--- $(date -u +%FT%TZ) wifi-unblock ---"
if rfkill list wifi 2>/dev/null | grep -q "Soft blocked: yes"; then
  rfkill unblock wifi || true
  if nmcli -t g 2>/dev/null | grep -q running; then
    nmcli radio wifi on || true
  fi
fi
rfkill list wifi || true
