From ef4aaf1763320830321450c42d9d89d6eab5d749 Mon Sep 17 00:00:00 2001
From: 24bit192khz <118996408+24bit192kHz@users.noreply.github.com>
Date: Tue, 15 Sep 2026 03:00:00 +0300
Subject: [PATCH 04/14] mstimeout: ms-suffix sub-second timeout support

mstimeout: ms-suffix sub-second timeout support.
---
 grub-core/normal/menu.c | 137 ++++++++++++++++++++++++++++++++++++----
 1 file changed, 123 insertions(+), 14 deletions(-)

diff --git a/grub-core/normal/menu.c b/grub-core/normal/menu.c
index b946c834d..514a4cff7 100644
--- a/grub-core/normal/menu.c
+++ b/grub-core/normal/menu.c
@@ -135,15 +135,31 @@ grub_menu_get_timeout (void)
 
   grub_error_push ();
 
-  timeout = (int) grub_strtoul (val, 0, 0);
+  {
+    const char *tail = 0;
+    int is_ms = 0;
 
-  /* If the value is invalid, unset the variable.  */
-  if (grub_errno != GRUB_ERR_NONE)
-    {
-      grub_env_unset ("timeout");
-      grub_errno = GRUB_ERR_NONE;
-      timeout = -1;
-    }
+    timeout = (int) grub_strtoul (val, &tail, 0);
+
+    /* "350ms" suffix selects milliseconds. Plain "2" stays seconds. */
+    if (grub_errno == GRUB_ERR_NONE && tail && tail[0] == 'm'
+	&& tail[1] == 's' && tail[2] == '\0')
+      is_ms = 1;
+    else if (grub_errno == GRUB_ERR_NONE && tail && tail[0] != '\0')
+      grub_error (GRUB_ERR_BAD_NUMBER, N_("invalid timeout value `%s'"), val);
+
+    /* If the value is invalid, unset the variable.  */
+    if (grub_errno != GRUB_ERR_NONE)
+      {
+	grub_env_unset ("timeout");
+	grub_errno = GRUB_ERR_NONE;
+	timeout = -1;
+      }
+    else if (timeout >= 0 && is_ms)
+      /* Below -1000 encodes remaining ms: -1000 - ms.
+	 Plain seconds stay positive. -1 stays unset. */
+      timeout = -1000 - timeout;
+  }
 
   grub_error_pop ();
 
@@ -162,6 +178,13 @@ grub_menu_set_timeout (int timeout)
       grub_snprintf (buf, sizeof (buf), "%d", timeout);
       grub_env_set ("timeout", buf);
     }
+  else if (timeout < -1000)
+    {
+      char buf[24];
+
+      grub_snprintf (buf, sizeof (buf), "%dms", -1000 - timeout);
+      grub_env_set ("timeout", buf);
+    }
 }
 
 /* Get the first entry number from the value of the environment variable NAME,
@@ -555,6 +578,40 @@ has_second_elapsed (grub_uint64_t *saved_time)
     return 0;
 }
 
+/* Ceil milliseconds to whole seconds without 64-bit division
+   (i386 normal.mod has no __udivdi3). Values here are small.  */
+static int
+ms_to_secs (grub_uint64_t ms)
+{
+  int s = 0;
+  while (ms > 0)
+    {
+      s++;
+      if (ms > 1000)
+	ms -= 1000;
+      else
+	break;
+    }
+  return s;
+}
+
+/* Millisecond tick for sub-second timeouts. Expiry uses absolute
+   deadline at call site; this only paces display refreshes.  */
+static int
+has_ms_elapsed (grub_uint64_t *saved_time, int interval_ms)
+{
+  grub_uint64_t current_time;
+
+  current_time = grub_get_time_ms ();
+  if (current_time - *saved_time >= (grub_uint64_t) interval_ms)
+    {
+      *saved_time = current_time;
+      return 1;
+    }
+  else
+    return 0;
+}
+
 static void
 print_countdown (struct grub_term_coordinate *pos, int n)
 {
@@ -591,7 +648,7 @@ run_menu (grub_menu_t menu, int nested, int *auto_boot, int *notify_boot)
     default_entry = 0;
 
   timeout = grub_menu_get_timeout ();
-  if (timeout < 0)
+  if (timeout == -1)
     /* If there is no timeout, the "countdown" and "hidden" styles result in
        the system doing nothing and providing no or very little indication
        why.  Technically this is what the user asked for, but it's not very
@@ -608,13 +665,18 @@ run_menu (grub_menu_t menu, int nested, int *auto_boot, int *notify_boot)
 
       if (timeout_style == TIMEOUT_STYLE_COUNTDOWN && timeout)
 	{
+	  int show = (timeout < -1000) ? ms_to_secs ((grub_uint64_t) (-1000 - timeout)) : timeout;
 	  pos = grub_term_save_pos ();
-	  print_countdown (pos, timeout);
+	  print_countdown (pos, show);
 	}
 
       /* Enter interruptible sleep until Escape or a menu hotkey is pressed,
          or the timeout expires.  */
       saved_time = grub_get_time_ms ();
+      grub_uint64_t cd_deadline = 0;
+      int cd_ms = (timeout < -1000);
+      if (cd_ms)
+        cd_deadline = saved_time + (grub_uint64_t) (-1000 - timeout);
       while (1)
 	{
 	  int key;
@@ -632,12 +694,28 @@ run_menu (grub_menu_t menu, int nested, int *auto_boot, int *notify_boot)
 	      break;
 	    }
 
-	  if (timeout > 0 && has_second_elapsed (&saved_time))
+	  if (! cd_ms && timeout > 0 && has_second_elapsed (&saved_time))
 	    {
 	      timeout--;
 	      if (timeout_style == TIMEOUT_STYLE_COUNTDOWN)
 		print_countdown (pos, timeout);
 	    }
+	  else if (cd_ms)
+	    {
+	      grub_uint64_t now = grub_get_time_ms ();
+	      if (timeout_style == TIMEOUT_STYLE_COUNTDOWN
+	          && has_ms_elapsed (&saved_time, 100))
+	        {
+	          int remain = (cd_deadline > now)
+	            ? ms_to_secs (cd_deadline - now) : 0;
+	          print_countdown (pos, remain);
+	        }
+	      if (now >= cd_deadline)
+	        {
+	          timeout = 0;
+	          cd_ms = 0;
+	        }
+	    }
 
 	  if (timeout == 0)
 	    /* We will fall through to auto-booting the default entry.  */
@@ -671,10 +749,18 @@ run_menu (grub_menu_t menu, int nested, int *auto_boot, int *notify_boot)
 
   timeout = grub_menu_get_timeout ();
 
-  if (timeout > 0)
+  grub_uint64_t mm_deadline = 0;
+  int mm_ms = (timeout < -1000);
+  if (mm_ms)
+    {
+      mm_deadline = saved_time + (grub_uint64_t) (-1000 - timeout);
+      menu_print_timeout (ms_to_secs ((grub_uint64_t) (-1000 - timeout)));
+    }
+  else if (timeout > 0)
     menu_print_timeout (timeout);
-  else
+  else if (timeout == -1)
     clear_timeout ();
+  /* plain 0 skips drawing: auto-boot path below handles it */
 
   while (1)
     {
@@ -690,6 +776,19 @@ run_menu (grub_menu_t menu, int nested, int *auto_boot, int *notify_boot)
 	  grub_menu_set_timeout (timeout);
 	  menu_print_timeout (timeout);
 	}
+	  else if (mm_ms)
+	    {
+	      grub_uint64_t now = grub_get_time_ms ();
+	      if (now >= mm_deadline)
+	        {
+	          grub_env_unset ("timeout");
+	          timeout = 0;
+	          mm_ms = 0;
+	        }
+	      /* display refresh only; expiry absolute */
+	      else if (has_ms_elapsed (&saved_time, 100))
+	        menu_print_timeout (ms_to_secs (mm_deadline - now));
+	    }
 
       if (timeout == 0)
 	{
@@ -702,9 +801,19 @@ run_menu (grub_menu_t menu, int nested, int *auto_boot, int *notify_boot)
       c = grub_getkey_noblock ();
 
       /* Negative values are returned on error. */
+      /* Any key stops the countdown (stock GRUB behavior: arrows/home/end
+         move AND cancel the timer). ms path matches: first keypress clears. */
       if ((c != GRUB_TERM_NO_KEY) && (c > 0))
 	{
-	  if (timeout >= 0)
+	  if (mm_ms)
+	    {
+	      grub_env_unset ("timeout");
+	      grub_env_unset ("fallback");
+	      clear_timeout ();
+	      mm_ms = 0;
+	      timeout = -1;
+	    }
+	  else if (timeout >= 0)
 	    {
 	      grub_env_unset ("timeout");
 	      grub_env_unset ("fallback");
-- 
