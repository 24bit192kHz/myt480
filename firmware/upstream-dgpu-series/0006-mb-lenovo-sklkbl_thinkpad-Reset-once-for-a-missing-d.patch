From 22b08dabdaa1da145579ce313f033be33dd6c3e5 Mon Sep 17 00:00:00 2001
From: 24bit192kHz <24bit192khz@proton.me>
Date: Wed, 30 Sep 2026 18:38:00 +0300
Subject: [PATCH 06/12] mb/lenovo/sklkbl_thinkpad: Reset once for a missing
 dGPU link

FSP-S disables a root port whose link is down, and a disabled port stays
disabled until the next power cycle, so the first boot after the dGPU is
enabled needs a full reset. A GPU that never links would make every warm
boot reset again, forever. Remember the attempt in CMOS byte 0x6d: the
second time, log it and boot without the GPU; a successful boot clears
the flag.

TEST=T480: enable the dGPU from a boot with the port disabled, one
reset, GPU present, flag cleared. With the GPU held in reset the machine
boots without it after a single reset.

Change-Id: I973c22bd2994eeb264cff607c4d81b17a7761040
Signed-off-by: 24bit192kHz <24bit192khz@proton.me>
---
 src/mainboard/lenovo/sklkbl_thinkpad/dgpu.c    | 13 +++++++++++--
 src/mainboard/lenovo/sklkbl_thinkpad/variant.h |  4 ++++
 2 files changed, 15 insertions(+), 2 deletions(-)

diff --git a/src/mainboard/lenovo/sklkbl_thinkpad/dgpu.c b/src/mainboard/lenovo/sklkbl_thinkpad/dgpu.c
index a6eb6fc272..833dd54b3e 100644
--- a/src/mainboard/lenovo/sklkbl_thinkpad/dgpu.c
+++ b/src/mainboard/lenovo/sklkbl_thinkpad/dgpu.c
@@ -4,6 +4,7 @@
 #include <acpi/acpigen.h>
 #include <cf9_reset.h>
 #include <console/console.h>
+#include <pc80/mc146818rtc.h>
 #include <delay.h>
 #include <device/device.h>
 #include <device/pci_def.h>
@@ -131,10 +132,18 @@ void dgpu_detect(void)
 		const struct chipset_power_state *ps = pmc_get_power_state();
 
 		if (ps && (ps->gen_pmcon_a & MEM_SR)) {
-			printk(BIOS_INFO, "dGPU: root port is disabled, full reset\n");
-			full_reset();
+			/* Once: a link that never comes up must not reset forever */
+			if (cmos_read(CMOS_DGPU_RESET) != DGPU_RESET_TRIED) {
+				cmos_write(DGPU_RESET_TRIED, CMOS_DGPU_RESET);
+				printk(BIOS_INFO, "dGPU: root port is disabled, full reset\n");
+				full_reset();
+			}
+			cmos_write(0, CMOS_DGPU_RESET);
+			printk(BIOS_ERR, "dGPU: root port still disabled after a reset, booting without the GPU\n");
 		}
 	}
+	if (rp && rp->enabled && cmos_read(CMOS_DGPU_RESET) == DGPU_RESET_TRIED)
+		cmos_write(0, CMOS_DGPU_RESET);
 
 	if (!rp || !rp->enabled) {
 		printk(BIOS_ERR, "dGPU: no PCIe link, powering it off\n");
diff --git a/src/mainboard/lenovo/sklkbl_thinkpad/variant.h b/src/mainboard/lenovo/sklkbl_thinkpad/variant.h
index a46f51eb2d..447757a521 100644
--- a/src/mainboard/lenovo/sklkbl_thinkpad/variant.h
+++ b/src/mainboard/lenovo/sklkbl_thinkpad/variant.h
@@ -11,6 +11,10 @@ void variant_config_gpios(void);
 
 uint8_t variant_memory_sku(void);
 
+/* CMOS byte 0x6d: 0xa5 while a full reset for a missing GPU link is in flight */
+#define CMOS_DGPU_RESET		0x6d
+#define DGPU_RESET_TRIED	0xa5
+
 void dgpu_power_on(void);
 void dgpu_wait_for_link(void);
 bool dgpu_present(void);
-- 
