From fa464461a78ce6c3a5a467b8a309669b2ee4a72a Mon Sep 17 00:00:00 2001
From: 24bit192kHz <24bit192khz@proton.me>
Date: Tue, 29 Sep 2026 22:37:54 +0300
Subject: [PATCH 03/15] mb/lenovo/sklkbl_thinkpad: Add a power resource for the
 dGPU

Let the OS turn the dGPU off and on at runtime (D3cold) with an ACPI
power resource for root port 1. The sequence follows the vendor
firmware: disable the link and wait for it to go down before the GPU is
put into reset and loses power, and enable the link again when the GPU
has left reset.

Without the dGPU, root port 7 takes the place of root port 1 at 00:1c.0,
and RP01 in the DSDT describes that one. Add the power resource in the
SSDT, and only if the dGPU is there, so that it cannot end up at the
wrong root port.

TEST=Lenovo ThinkPad T480 with GeForce MX150, Linux 7.2: without a
     driver the root port and the GPU go to D3cold and the power rail
     is off. Loading the NVIDIA driver 580.178.04 turns the GPU on,
     70 load/unload cycles in a row, S3 resume with a program running on
     the GPU (video memory preserved by the driver).

Change-Id: I1e821855916e285123909cff581cccc6f48ca241
Co-authored-by: Claude <noreply@anthropic.com>
Signed-off-by: 24bit192kHz <24bit192khz@proton.me>
---
 .../lenovo/sklkbl_thinkpad/acpi/dgpu.asl      | 70 +++++++++++++++++++
 src/mainboard/lenovo/sklkbl_thinkpad/dgpu.c   | 39 +++++++++++
 src/mainboard/lenovo/sklkbl_thinkpad/dsdt.asl |  4 ++
 .../lenovo/sklkbl_thinkpad/ramstage.c         |  4 +-
 .../lenovo/sklkbl_thinkpad/variant.h          |  3 +
 5 files changed, 119 insertions(+), 1 deletion(-)
 create mode 100644 src/mainboard/lenovo/sklkbl_thinkpad/acpi/dgpu.asl

diff --git a/src/mainboard/lenovo/sklkbl_thinkpad/acpi/dgpu.asl b/src/mainboard/lenovo/sklkbl_thinkpad/acpi/dgpu.asl
new file mode 100644
index 0000000000..067a17a450
--- /dev/null
+++ b/src/mainboard/lenovo/sklkbl_thinkpad/acpi/dgpu.asl
@@ -0,0 +1,70 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+
+#include <variant/dgpu.h>
+
+/*
+ * Power sequencing of the discrete GPU behind root port 1, for the power
+ * resource that dgpu.c adds to the SSDT when the GPU is enabled. The
+ * sequence follows the vendor firmware: the link is disabled before the
+ * GPU loses power, and enabled again once the GPU is out of reset.
+ */
+Scope (\_SB.PCI0.RP01)
+{
+	OperationRegion (DGPC, PCI_Config, 0x50, 4)
+	Field (DGPC, AnyAcc, NoLock, Preserve)
+	{
+		    , 4,
+		LNKD, 1,	/* Link Control: Link Disable */
+		    , 24,
+		DLLA, 1,	/* Link Status: Data Link Layer Link Active */
+	}
+
+	/* Wait up to 200 ms for the link to reach the state in Arg0 */
+	Method (DGLW, 1, Serialized)
+	{
+		Local0 = 0
+		While (DLLA != Arg0 && Local0 < 200) {
+			Sleep (10)
+			Local0 += 10
+		}
+	}
+
+	Method (DGST, 0, NotSerialized)
+	{
+		Return (\_SB.PCI0.GTXS (GPIO_1R8VIDEO_AON_ON))
+	}
+
+	Method (DGON, 0, Serialized)
+	{
+		If (\_SB.PCI0.GTXS (GPIO_1R8VIDEO_AON_ON)) {
+			Return
+		}
+
+		\_SB.PCI0.STXS (GPIO_1R8VIDEO_AON_ON)
+
+		Local0 = 0
+		While (!\_SB.PCI0.GRXS (GPIO_DGFX_PWRGD) && Local0 < 100) {
+			Sleep (1)
+			Local0++
+		}
+		Sleep (10)
+
+		\_SB.PCI0.STXS (GPIO_GPU_RST)
+		LNKD = 0
+		DGLW (1)
+	}
+
+	Method (DGOF, 0, Serialized)
+	{
+		If (!\_SB.PCI0.GTXS (GPIO_1R8VIDEO_AON_ON)) {
+			Return
+		}
+
+		LNKD = 1
+		DGLW (0)
+
+		\_SB.PCI0.CTXS (GPIO_GPU_RST)
+		\_SB.PCI0.CTXS (GPIO_1R8VIDEO_AON_ON)
+		Sleep (100)
+	}
+}
diff --git a/src/mainboard/lenovo/sklkbl_thinkpad/dgpu.c b/src/mainboard/lenovo/sklkbl_thinkpad/dgpu.c
index a1c5f30394..8e8c8e80a6 100644
--- a/src/mainboard/lenovo/sklkbl_thinkpad/dgpu.c
+++ b/src/mainboard/lenovo/sklkbl_thinkpad/dgpu.c
@@ -1,5 +1,6 @@
 /* SPDX-License-Identifier: GPL-2.0-only */
 
+#include <acpi/acpigen.h>
 #include <console/console.h>
 #include <delay.h>
 #include <device/device.h>
@@ -98,6 +99,44 @@ static void dgpu_power_off(void)
 	gpio_set(GPIO_1R8VIDEO_AON_ON, 0);
 }
 
+/*
+ * Runtime power management (D3cold) for the GPU: a power resource on its
+ * root port, which calls the methods in acpi/dgpu.asl. Without the GPU, the
+ * PCH may have another root port at the device and function of root port 1,
+ * so only add it for a GPU that is there.
+ */
+void dgpu_fill_ssdt(const struct device *dev)
+{
+	static const char * const power_states[] = { "_PR0", "_PR3" };
+	const struct device *dgpu = DEV_PTR(dgpu);
+	const char *scope;
+
+	if (!is_dev_enabled(dgpu) || !dgpu->upstream)
+		return;
+
+	scope = acpi_device_path(dgpu->upstream->dev);
+	if (!scope)
+		return;
+
+	acpigen_write_scope(scope);
+	acpigen_write_power_res("PGPU", 0, 0, power_states, ARRAY_SIZE(power_states));
+
+	acpigen_write_method("_STA", 0);
+	acpigen_write_return_namestr("DGST");
+	acpigen_write_method_end();
+
+	acpigen_write_method_serialized("_ON", 0);
+	acpigen_emit_namestring("DGON");
+	acpigen_write_method_end();
+
+	acpigen_write_method_serialized("_OFF", 0);
+	acpigen_emit_namestring("DGOF");
+	acpigen_write_method_end();
+
+	acpigen_write_power_res_end();
+	acpigen_write_scope_end();
+}
+
 /* Runs after FSP-S and before the PCI scan; the GPU was powered before FSP-S */
 void dgpu_detect(void)
 {
diff --git a/src/mainboard/lenovo/sklkbl_thinkpad/dsdt.asl b/src/mainboard/lenovo/sklkbl_thinkpad/dsdt.asl
index 801e0cb0d1..a356370a0f 100644
--- a/src/mainboard/lenovo/sklkbl_thinkpad/dsdt.asl
+++ b/src/mainboard/lenovo/sklkbl_thinkpad/dsdt.asl
@@ -22,5 +22,9 @@ DefinitionBlock(
 		#include <drivers/intel/gma/acpi/default_brightness_levels.asl>
 	}
 
+#if CONFIG(VARIANT_HAS_DGPU)
+	#include "acpi/dgpu.asl"
+#endif
+
 	#include <southbridge/intel/common/acpi/sleepstates.asl>
 }
diff --git a/src/mainboard/lenovo/sklkbl_thinkpad/ramstage.c b/src/mainboard/lenovo/sklkbl_thinkpad/ramstage.c
index 46d7c64037..9c4b97ff3b 100644
--- a/src/mainboard/lenovo/sklkbl_thinkpad/ramstage.c
+++ b/src/mainboard/lenovo/sklkbl_thinkpad/ramstage.c
@@ -26,8 +26,10 @@ void mainboard_silicon_init_params(FSP_SIL_UPD *params)
 
 static void mainboard_enable(struct device *dev)
 {
-	if (CONFIG(VARIANT_HAS_DGPU))
+	if (CONFIG(VARIANT_HAS_DGPU)) {
 		dgpu_detect();
+		dev->ops->acpi_fill_ssdt = dgpu_fill_ssdt;
+	}
 }
 
 struct chip_operations mainboard_ops = {
diff --git a/src/mainboard/lenovo/sklkbl_thinkpad/variant.h b/src/mainboard/lenovo/sklkbl_thinkpad/variant.h
index 50be150f04..8789386167 100644
--- a/src/mainboard/lenovo/sklkbl_thinkpad/variant.h
+++ b/src/mainboard/lenovo/sklkbl_thinkpad/variant.h
@@ -5,11 +5,14 @@
 
 #include <types.h>
 
+struct device;
+
 void variant_config_gpios(void);
 
 uint8_t variant_memory_sku(void);
 
 void dgpu_power_on(void);
 void dgpu_detect(void);
+void dgpu_fill_ssdt(const struct device *dev);
 
 #endif
