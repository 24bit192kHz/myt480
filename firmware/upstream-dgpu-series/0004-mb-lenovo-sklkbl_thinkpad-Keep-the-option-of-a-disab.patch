From 6c8e32db29057ff805eeca126adc95d8b8c14dd3 Mon Sep 17 00:00:00 2001
From: 24bit192kHz <24bit192khz@proton.me>
Date: Tue, 29 Sep 2026 22:37:54 +0300
Subject: [PATCH 04/15] mb/lenovo/sklkbl_thinkpad: Keep the option of a
 disabled dGPU

The setup menu hides the option "dgpu_enable" if the device of the dGPU
is disabled, and dgpu_detect() disables that device when the option is
off. So the option hides itself once it is turned off.

Hide it only if the board has no dGPU.

TEST=Builds for T480 and X280 with PAYLOAD_EDK2 and SMMSTORE. Not run:
     the setup menu was not available on the test machine.

Change-Id: I1ab68f8b041399591ba0a4d7f429461a5e27c5fe
Co-authored-by: Claude <noreply@anthropic.com>
Signed-off-by: 24bit192kHz <24bit192khz@proton.me>
---
 src/mainboard/lenovo/sklkbl_thinkpad/cfr.c     | 8 ++------
 src/mainboard/lenovo/sklkbl_thinkpad/dgpu.c    | 7 ++++++-
 src/mainboard/lenovo/sklkbl_thinkpad/variant.h | 1 +
 3 files changed, 9 insertions(+), 7 deletions(-)

diff --git a/src/mainboard/lenovo/sklkbl_thinkpad/cfr.c b/src/mainboard/lenovo/sklkbl_thinkpad/cfr.c
index 5585d1567b..103cc5dc42 100644
--- a/src/mainboard/lenovo/sklkbl_thinkpad/cfr.c
+++ b/src/mainboard/lenovo/sklkbl_thinkpad/cfr.c
@@ -4,17 +4,13 @@
 #include <drivers/option/cfr_frontend.h>
 #include <intelblocks/cfr.h>
 #include <soc/cfr.h>
-#include <static.h>
-
-WEAK_DEV_PTR(dgpu);
+#include "variant.h"
 
 /* Hide the dGPU CFR entry if dGPU not present */
 static void update_dgpu(struct sm_object *new)
 {
-	struct device *dgpu = DEV_PTR(dgpu);
-	if (!dgpu || !dgpu->enabled) {
+	if (!CONFIG(VARIANT_HAS_DGPU) || !dgpu_present())
 		new->sm_bool.flags = CFR_OPTFLAG_SUPPRESS;
-	}
 }
 
 /* dGPU */
diff --git a/src/mainboard/lenovo/sklkbl_thinkpad/dgpu.c b/src/mainboard/lenovo/sklkbl_thinkpad/dgpu.c
index 8e8c8e80a6..1fedee19cc 100644
--- a/src/mainboard/lenovo/sklkbl_thinkpad/dgpu.c
+++ b/src/mainboard/lenovo/sklkbl_thinkpad/dgpu.c
@@ -137,6 +137,11 @@ void dgpu_fill_ssdt(const struct device *dev)
 	acpigen_write_scope_end();
 }
 
+bool dgpu_present(void)
+{
+	return gpio_get(GPIO_DISCRETE_PRESENCE) == 0;	/* active low */
+}
+
 /* Runs after FSP-S and before the PCI scan; the GPU was powered before FSP-S */
 void dgpu_detect(void)
 {
@@ -145,7 +150,7 @@ void dgpu_detect(void)
 	const struct device *rp = dgpu->upstream ? dgpu->upstream->dev : NULL;
 	int dgfx_vram_id;
 
-	if (gpio_get(GPIO_DISCRETE_PRESENCE) != 0) { // active low
+	if (!dgpu_present()) {
 		printk(BIOS_DEBUG, "dGPU: not present\n");
 		dgpu->enabled = 0;
 		return;
diff --git a/src/mainboard/lenovo/sklkbl_thinkpad/variant.h b/src/mainboard/lenovo/sklkbl_thinkpad/variant.h
index 8789386167..9dd206c12a 100644
--- a/src/mainboard/lenovo/sklkbl_thinkpad/variant.h
+++ b/src/mainboard/lenovo/sklkbl_thinkpad/variant.h
@@ -12,6 +12,7 @@ void variant_config_gpios(void);
 uint8_t variant_memory_sku(void);
 
 void dgpu_power_on(void);
+bool dgpu_present(void);
 void dgpu_detect(void);
 void dgpu_fill_ssdt(const struct device *dev);
 
