From fe332d060a7eba928809c76a904a906e731ac1cc Mon Sep 17 00:00:00 2001
From: 24bit192kHz <24bit192khz@proton.me>
Date: Thu, 1 Oct 2026 16:06:47 +0300
Subject: [PATCH 17/17] mb/lenovo/sklkbl_thinkpad/t480: Set the subsystem IDs

The vendor firmware gives the PCH and system agent devices of the T480
the subsystem IDs 17aa:225d. The subsystemid in devicetree.cb does not
reach them: when an override tree names the domain, sconfig replaces
the IDs with the unset ones of the override device. Give them in the
T480 override tree, from where soc/intel/skylake also hands them to FSP.

TEST=T480: lspci shows 17aa:225d on all PCH and system agent devices
(the iGPU keeps 17aa:2212), the ramstage log has 16 "subsystem <-
17aa/225d" lines; cold boot from S5 and S3 resume with the dGPU pass.

Change-Id: Ib100b27a95f6f8e277fab5091fd814d7ecc3cdbd
Co-authored-by: Claude <noreply@anthropic.com>
Signed-off-by: 24bit192kHz <24bit192khz@proton.me>
---
 .../lenovo/sklkbl_thinkpad/variants/t480/overridetree.cb       | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/src/mainboard/lenovo/sklkbl_thinkpad/variants/t480/overridetree.cb b/src/mainboard/lenovo/sklkbl_thinkpad/variants/t480/overridetree.cb
index 412bba3268..ee1e9ad808 100644
--- a/src/mainboard/lenovo/sklkbl_thinkpad/variants/t480/overridetree.cb
+++ b/src/mainboard/lenovo/sklkbl_thinkpad/variants/t480/overridetree.cb
@@ -2,6 +2,9 @@
 
 chip soc/intel/skylake
 	device domain 0 on
+		# The subsystemid of devicetree.cb does not survive this override of the
+		# domain in sconfig, so give it here.
+		subsystemid 0x17aa 0x225d inherit
 		device ref gmm on end	# Gaussian Mixture Model accelerator, as the vendor firmware
 		device ref south_xhci on
 			register "usb2_ports" = "{
-- 
