From cb084bcbda091eb840f9800bf2bb3760fe2193a5 Mon Sep 17 00:00:00 2001
From: 24bit192kHz <24bit192khz@proton.me>
Date: Wed, 30 Sep 2026 18:38:33 +0300
Subject: [PATCH 07/12] mb/lenovo/sklkbl_thinkpad/t480: Vendor PCIe payload
 sizes

The vendor firmware sets Max_Payload_Size 256 on root ports 1 (dGPU), 7
(WLAN) and 11 (SSD) and leaves the Thunderbolt port at 128; coreboot
left every port at the FSP default of 128. The enumeration code sets
each endpoint to the smaller of its own capability and the port's, so
the GPU and the NVMe drive now move 256-byte TLPs and the Wi-Fi card
stays at 128.

TEST=T480: lspci shows MaxPayload 256 on 00:1c.0, 01:00.0, 00:1d.2 and
the NVMe drive, 128 on the WLAN port and card; GRUB and Linux boot from
the NVMe drive, GPU load test passes.

Change-Id: I68282d42df3d974371227be0c1bff042ee7c7406
Signed-off-by: 24bit192kHz <24bit192khz@proton.me>
---
 .../lenovo/sklkbl_thinkpad/variants/t480/overridetree.cb     | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/src/mainboard/lenovo/sklkbl_thinkpad/variants/t480/overridetree.cb b/src/mainboard/lenovo/sklkbl_thinkpad/variants/t480/overridetree.cb
index a771aa1916..bc8e44a75c 100644
--- a/src/mainboard/lenovo/sklkbl_thinkpad/variants/t480/overridetree.cb
+++ b/src/mainboard/lenovo/sklkbl_thinkpad/variants/t480/overridetree.cb
@@ -35,6 +35,8 @@ chip soc/intel/skylake
 		#   PCIE 9-10  - RP9  - TB3  - CLKOUT4 - CLKREQ4
 		#   PCIE 11-12 - RP11 - SSD  - CLKOUT5 - CLKREQ5
 
+		# Root ports 1, 7 and 11 allow 256-byte TLPs as on the vendor firmware; the
+		# Thunderbolt port stays at 128 there.
 		# dGPU - x4
 		device ref pcie_rp1 on
 			register "PcieRpClkReqSupport[0]"		= "true"
@@ -42,6 +44,7 @@ chip soc/intel/skylake
 			register "PcieRpClkSrcNumber[0]"		= "0"
 			register "PcieRpAdvancedErrorReporting[0]"	= "true"
 			register "PcieRpLtrEnable[0]"			= "true"
+			register "PcieRpMaxPayload[0]"			= "RpMaxPayload_256"
 			chip drivers/pcie/generic
 				register "name" = ""PEGP""
 				device pci 00.0 alias dgpu on end
@@ -63,6 +66,7 @@ chip soc/intel/skylake
 			register "PcieRpClkSrcNumber[6]"		= "2"
 			register "PcieRpAdvancedErrorReporting[6]"	= "true"
 			register "PcieRpLtrEnable[6]"			= "true"
+			register "PcieRpMaxPayload[6]"			= "RpMaxPayload_256"
                         smbios_slot_desc "SlotTypeM2Socket1_DP" "SlotLengthOther" "M.2/A 2230" "SlotDataBusWidth1X"
 		end
 
@@ -93,6 +97,7 @@ chip soc/intel/skylake
 			register "PcieRpClkSrcNumber[10]"		= "5"
 			register "PcieRpAdvancedErrorReporting[10]"	= "true"
 			register "PcieRpLtrEnable[10]"			= "true"
+			register "PcieRpMaxPayload[10]"			= "RpMaxPayload_256"
                         smbios_slot_desc "SlotTypeM2Socket3" "SlotLengthOther" "M.2/M 2280 Sub Card" "SlotDataBusWidth2X"
 		end
 	end
