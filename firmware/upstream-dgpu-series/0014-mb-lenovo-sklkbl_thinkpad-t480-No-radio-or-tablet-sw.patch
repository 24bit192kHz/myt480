From f3c3e27c48aa87c427dfa01c39211d19a817b923 Mon Sep 17 00:00:00 2001
From: 24bit192kHz <24bit192khz@proton.me>
Date: Thu, 1 Oct 2026 16:06:26 +0300
Subject: [PATCH 14/17] mb/lenovo/sklkbl_thinkpad/t480: No radio or tablet
 switch

The T480 has neither a wireless switch nor a tablet mode switch: its EC
reads 0 at the wireless switch bit, and the vendor firmware has a
constant WLSW and no MHKG. Select H8_NO_WIRELESS_SWITCH and
H8_NO_TABLET_MODE_SWITCH for the T480 only; the other variants were not
tested, and the X380 Yoga has a tablet switch.

TEST=T480: Bluetooth is no longer hard-blocked, initialises and loads
its firmware; no tablet mode switch.

Change-Id: I8ac9653faec9e77764e27dc3da4593eec458ad37
Co-authored-by: Claude <noreply@anthropic.com>
Signed-off-by: 24bit192kHz <24bit192khz@proton.me>
---
 src/mainboard/lenovo/sklkbl_thinkpad/Kconfig | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/src/mainboard/lenovo/sklkbl_thinkpad/Kconfig b/src/mainboard/lenovo/sklkbl_thinkpad/Kconfig
index a544def293..282031b694 100644
--- a/src/mainboard/lenovo/sklkbl_thinkpad/Kconfig
+++ b/src/mainboard/lenovo/sklkbl_thinkpad/Kconfig
@@ -33,6 +33,8 @@ config BOARD_LENOVO_T470S
 config BOARD_LENOVO_T480
 	select BOARD_LENOVO_SKLKBL_THINKPAD_COMMON
 	select DRIVERS_INTEL_DTBT
+	select H8_NO_TABLET_MODE_SWITCH
+	select H8_NO_WIRELESS_SWITCH
 	select SOC_INTEL_KABYLAKE
 	select MEC1653_HAS_DEBUG_UNLOCK
 	select VARIANT_HAS_DGPU
