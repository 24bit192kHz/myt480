From 40dea83cc4d955d148845fa198ef1ae1e170fbe0 Mon Sep 17 00:00:00 2001
From: 24bit192kHz <24bit192khz@proton.me>
Date: Thu, 1 Oct 2026 16:05:54 +0300
Subject: [PATCH 09/17] ec/lenovo/h8: Add an option for boards without a radio
 switch

Newer ECs have no master wireless switch bit at 0x48. It reads 0, so
thinkpad_acpi hard-blocks Bluetooth and WWAN on every boot, while the
vendor firmware's WLSW is a constant. With H8_NO_WIRELESS_SWITCH, WLSW
returns 1.

TEST=T480 with the option selected: thinkpad_acpi reports "radio switch
found; radios are enabled", the Bluetooth and WWAN rfkill switches are
unblocked.

Change-Id: Ia3ffeeb3951c4c42829c10e97db9d85c1efbdcac
Co-authored-by: Claude <noreply@anthropic.com>
Signed-off-by: 24bit192kHz <24bit192khz@proton.me>
---
 src/ec/lenovo/h8/Kconfig           | 8 ++++++++
 src/ec/lenovo/h8/acpi/thinkpad.asl | 4 ++++
 2 files changed, 12 insertions(+)

diff --git a/src/ec/lenovo/h8/Kconfig b/src/ec/lenovo/h8/Kconfig
index 7f6d45be30..bca8dea938 100644
--- a/src/ec/lenovo/h8/Kconfig
+++ b/src/ec/lenovo/h8/Kconfig
@@ -96,4 +96,12 @@ config H8_HAS_2ND_THERMAL_ZONE
 	bool
 	default n
 
+config H8_NO_WIRELESS_SWITCH
+	bool
+	default n
+	help
+	  The EC has no master wireless switch bit at 0x48 (newer boards); the
+	  ACPI WLSW method then reports the radios as enabled, as the vendor
+	  firmware does, instead of a bit that reads 0 and hard-blocks them.
+
 endif # EC_LENOVO_H8
diff --git a/src/ec/lenovo/h8/acpi/thinkpad.asl b/src/ec/lenovo/h8/acpi/thinkpad.asl
index f8f2dc0292..341fdb7f19 100644
--- a/src/ec/lenovo/h8/acpi/thinkpad.asl
+++ b/src/ec/lenovo/h8/acpi/thinkpad.asl
@@ -152,7 +152,11 @@ Device (HKEY)
 	/* Master wireless switch state */
 	Method (WLSW, 0, NotSerialized)
 	{
+#if CONFIG(H8_NO_WIRELESS_SWITCH)
+		Return (1)
+#else
 		Return (\_SB.PCI0.LPCB.EC.GSTS)
+#endif
 	}
 
 	/* Set to one on first boot */
-- 
