 }
 
 static void mainboard_enable(struct device *dev)
diff --git a/src/mainboard/lenovo/sklkbl_thinkpad/variant.h b/src/mainboard/lenovo/sklkbl_thinkpad/variant.h
index f3c704754f..c772bdb994 100644
--- a/src/mainboard/lenovo/sklkbl_thinkpad/variant.h
+++ b/src/mainboard/lenovo/sklkbl_thinkpad/variant.h
@@ -10,16 +10,13 @@ uint8_t variant_memory_sku(void);
 
 /* CMOS byte 0x6f: 0xd6 powers the dGPU from the next boot on (`dgpu on` in Linux) */
 #define CMOS_DGPU		0x6f
-/* CMOS byte 0x6d: 0xa5 while a full reset for a missing GPU link is in flight */
-#define CMOS_DGPU_RESET		0x6d
-#define DGPU_RESET_TRIED	0xa5
 /* CMOS byte 0x6c: 0x3c skips the dGPU on the next boot only (power-button override) */
 #define CMOS_DGPU_SKIP		0x6c
 #define DGPU_SKIP_ONCE		0x3c
 #define  DGPU_REQUEST		0xd6
 
 void dgpu_power_on(void);
-void dgpu_wait_for_link(void);
+bool dgpu_present(void);
 void dgpu_detect(void);
 void dgpu_fill_ssdt(const struct device *dev);
 
diff --git a/src/mainboard/lenovo/sklkbl_thinkpad/variants/t480/overridetree.cb b/src/mainboard/lenovo/sklkbl_thinkpad/variants/t480/overridetree.cb
