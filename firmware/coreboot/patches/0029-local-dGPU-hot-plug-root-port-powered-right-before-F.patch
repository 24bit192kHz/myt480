-#include <intelblocks/pmclib.h>
 #include <mainboard/lenovo/sklkbl_thinkpad/variant.h>
-#include <soc/pm.h>
-#include <soc/pmc.h>
+#include <soc/gpe.h>
 #include <static.h>
 #include <timer.h>
 #include <variant/dgpu.h>
 
 #define DGPU_LINK_TIMEOUT_MS	100
 
-/*
- * FSP-S disables root port 1 if it has no link. PCIe gives a device 100 ms
- * after its reset; do not let a fast boot path be faster than that.
- */
-void dgpu_wait_for_link(void)
+/* PCIe gives a device 100 ms after its reset; FSP-S has already run here */
+static bool dgpu_wait_for_link(void)
 {
 	const pci_devfn_t rp = PCI_DEV(0, 0x1c, 0);
 	struct stopwatch sw;
 	u16 cap;
 
-	if (!gpio_tx_get(GPIO_GPU_RST))
-		return;
-
 	cap = pci_s_find_capability(rp, PCI_CAP_ID_PCIE);
 	if (!cap)
-		return;
+		return false;
 
 	stopwatch_init_msecs_expire(&sw, DGPU_LINK_TIMEOUT_MS);
 	while (!(pci_s_read_config16(rp, cap + PCI_EXP_LNKSTA) & PCI_EXP_LNKSTA_DLLLA)) {
-		if (stopwatch_expired(&sw)) {
-			printk(BIOS_WARNING, "dGPU: no link after %d ms\n",
-			       DGPU_LINK_TIMEOUT_MS);
-			return;
-		}
+		if (stopwatch_expired(&sw))
+			return false;
 		mdelay(1);
 	}
 	printk(BIOS_DEBUG, "dGPU: link after %lld ms\n", stopwatch_duration_msecs(&sw));
+	return true;
 }
 
 static void dgpu_power_off(void)
@@ -75,6 +64,18 @@ void dgpu_fill_ssdt(const struct device *dev)
 		return;
 
 	acpigen_write_scope(scope);
+
+	/*
+	 * Linux puts a hot-plug port into D3 only if it can signal wake and
+	 * hot-plug events from there: a wake GPE in _PRW (the PCIe PME GPE,
+	 * as on the vendor firmware), D3cold in _S0W and the property
+	 * HotPlugSupportInD3. Without them the port stays in D0, and the
+	 * power resource is never turned off.
+	 */
+	acpigen_write_PRW(GPE0_PCI_EXP, 4);
+	acpigen_write_name_integer("_S0W", ACPI_DEVICE_SLEEP_D3_COLD);
+	acpi_device_add_hotplug_support_in_d3(NULL);
+
 	acpigen_write_power_res("PGPU", 0, 0, power_states, ARRAY_SIZE(power_states));
 
 	acpigen_write_method("_STA", 0);
@@ -93,7 +94,12 @@ void dgpu_fill_ssdt(const struct device *dev)
 	acpigen_write_scope_end();
 }
 
-/* The GPU was powered in the bootblock, see dgpu_early.c */
+bool dgpu_present(void)
+{
+	return gpio_get(GPIO_DISCRETE_PRESENCE) == 0;	/* active low */
+}
+
+/* Runs after FSP-S and before the PCI scan; the GPU was powered before FSP-S */
 void dgpu_detect(void)
 {
 	static const char * const dgfx_vram_id_str[] = { "1GB", "2GB", "4GB", "N/A" };
@@ -101,7 +107,7 @@ void dgpu_detect(void)
 	const struct device *rp = dgpu->upstream ? dgpu->upstream->dev : NULL;
 	int dgfx_vram_id;
 
-	if (gpio_get(GPIO_DISCRETE_PRESENCE) != 0) { // active low
+	if (!dgpu_present()) {
 		printk(BIOS_DEBUG, "dGPU: not present\n");
 		dgpu->enabled = 0;
 		return;
@@ -116,31 +122,7 @@ void dgpu_detect(void)
 		return;
 	}
 
-	/*
-	 * FSP-S disables a root port without a link, and a disabled port stays
-	 * disabled until the next power cycle: FSP-S does not find the GPU on
-	 * the first boot after it was enabled. A full reset cycles the power.
-	 * MEM_SR is only set after a reset without power cycle, so this
-	 * happens once.
-	 */
-	if ((!rp || !rp->enabled) && !acpi_is_wakeup_s3()) {
-		const struct chipset_power_state *ps = pmc_get_power_state();
-
-		if (ps && (ps->gen_pmcon_a & MEM_SR)) {
-			/* Once: a link that never comes up must not reset forever */
-			if (cmos_read(CMOS_DGPU_RESET) != DGPU_RESET_TRIED) {
-				cmos_write(DGPU_RESET_TRIED, CMOS_DGPU_RESET);
-				printk(BIOS_INFO, "dGPU: root port is disabled, full reset\n");
-				full_reset();
-			}
-			cmos_write(0, CMOS_DGPU_RESET);
-			printk(BIOS_ERR, "dGPU: root port still disabled after a reset, booting without the GPU\n");
-		}
-	}
-	if (rp && rp->enabled && cmos_read(CMOS_DGPU_RESET) == DGPU_RESET_TRIED)
-		cmos_write(0, CMOS_DGPU_RESET);
-
-	if (!rp || !rp->enabled) {
+	if (!rp || !rp->enabled || !dgpu_wait_for_link()) {
 		printk(BIOS_ERR, "dGPU: no PCIe link, powering it off\n");
 		dgpu_power_off();
 		dgpu->enabled = 0;
diff --git a/src/mainboard/lenovo/sklkbl_thinkpad/dgpu_early.c b/src/mainboard/lenovo/sklkbl_thinkpad/dgpu_early.c
