 /* SPDX-License-Identifier: GPL-2.0-only */
 
-#include <arch/io.h>
 #include <console/console.h>
 #include <delay.h>
 #include <gpio.h>
+#include <intelblocks/pmclib.h>
 #include <mainboard/lenovo/sklkbl_thinkpad/variant.h>
 #include <pc80/mc146818rtc.h>
-#include <soc/iomap.h>
 #include <soc/pm.h>
 #include <stdbool.h>
 #include <timer.h>
@@ -17,9 +16,11 @@
 #define DGPU_RESET_DELAY_MS	10
 
 /*
- * The dGPU sits behind PCIe root port 1. FSP-S disables root ports that have
- * no link, so the GPU has to be powered and out of reset well before
- * FspSiliconInit; the ramstage is too late for that. Do it in the bootblock.
+ * The dGPU sits behind PCIe root port 1. FSP-S disables root ports without a
+ * link, and the GPU has no link yet when FSP-S runs, so the devicetree marks
+ * the port as hot-pluggable: FSP-S then leaves it alone. Power the GPU and
+ * release its reset right before FSP-S (mainboard_silicon_init_params());
+ * dgpu_detect() waits for the link after FSP-S.
  *
  * Root port 1 uses CLKREQ0#, and the PCH only drives the reference clock
  * while that pad is in its native function, so set it up here as well.
@@ -52,7 +53,9 @@ void dgpu_power_on(void)
 	 * Clearing it instead cost the GPU after every rescue, battery swap or
 	 * hang until someone ran `dgpu on` again.
 	 */
-	if (inw(ACPI_BASE_ADDRESS + PM1_STS) & PRBTNOR_STS)
+	const struct chipset_power_state *ps = pmc_get_power_state();
+
+	if (ps && (ps->pm1_sts & PRBTNOR_STS))
 		cmos_write(DGPU_SKIP_ONCE, CMOS_DGPU_SKIP);
 	skip = cmos_read(CMOS_DGPU_SKIP) == DGPU_SKIP_ONCE;
 	cmos_write(0, CMOS_DGPU_SKIP);
