From 5a79c2b281532b919b0fba2b4229ea99a3922f38 Mon Sep 17 00:00:00 2001
From: 24bit192khz <118996408+24bit192kHz@users.noreply.github.com>
Date: Mon, 28 Sep 2026 14:31:47 +0300
Subject: [PATCH 02/28] mb/lenovo/sklkbl_thinkpad/t480: Cache SPD in
 RW_SPD_CACHE

Reading both SO-DIMM SPDs (2 x 512 bytes DDR4) over SMBus took ~100 ms
of every boot. Select SPD_CACHE_IN_FMAP and, like purism/librem_cnl,
only compare module serial numbers against the cached copy; on a change,
re-read over SMBus, refresh the cache and drop the MRC cache.
---
 src/mainboard/lenovo/sklkbl_thinkpad/Kconfig  |  1 +
 .../variants/t480/memory_init_params.c        | 34 +++++++++++++++++--
 2 files changed, 32 insertions(+), 3 deletions(-)

diff --git a/src/mainboard/lenovo/sklkbl_thinkpad/Kconfig b/src/mainboard/lenovo/sklkbl_thinkpad/Kconfig
index a544def293..edc16dd817 100644
--- a/src/mainboard/lenovo/sklkbl_thinkpad/Kconfig
+++ b/src/mainboard/lenovo/sklkbl_thinkpad/Kconfig
@@ -36,6 +36,7 @@ config BOARD_LENOVO_T480
 	select SOC_INTEL_KABYLAKE
 	select MEC1653_HAS_DEBUG_UNLOCK
 	select VARIANT_HAS_DGPU
+	select SPD_CACHE_IN_FMAP
 
 config BOARD_LENOVO_T480S
 	select BOARD_LENOVO_SKLKBL_THINKPAD_COMMON
diff --git a/src/mainboard/lenovo/sklkbl_thinkpad/variants/t480/memory_init_params.c b/src/mainboard/lenovo/sklkbl_thinkpad/variants/t480/memory_init_params.c
index 5252a402f9..902f17e8be 100644
--- a/src/mainboard/lenovo/sklkbl_thinkpad/variants/t480/memory_init_params.c
+++ b/src/mainboard/lenovo/sklkbl_thinkpad/variants/t480/memory_init_params.c
@@ -1,18 +1,46 @@
 /* SPDX-License-Identifier: GPL-2.0-only */
 
+#include <console/console.h>
 #include <soc/romstage.h>
 #include <spd_bin.h>
+#include <spd_cache.h>
 
 void mainboard_memory_init_params(FSPM_UPD *mupd)
 {
 	FSP_M_CONFIG *mem_cfg = &mupd->FspmConfig;
+	struct spd_block blk = { .addr_map = { 0x50, 0x51, } };
+	bool dimm_changed = true;
+
 	mem_cfg->DqPinsInterleaved = true;			/* DDR_DQ in interleave mode */
 	mem_cfg->CaVrefConfig      = 2;				/* VREF_CA to CH_A and VREF_DQ_B to CH_B */
 	mem_cfg->MemorySpdDataLen  = CONFIG_DIMM_SPD_SIZE;
 
-	/* Get SPD for memory slots */
-	struct spd_block blk = { .addr_map = { 0x50, 0x51, } };
-	get_spd_smbus(&blk);
+	/*
+	 * Reading two full DDR4 SPDs over SMBus costs ~100 ms on every boot.
+	 * Keep them in RW_SPD_CACHE and only compare the module serial numbers;
+	 * read everything again (and drop the MRC cache) when a DIMM changed.
+	 */
+	if (CONFIG(SPD_CACHE_IN_FMAP)) {
+		uint8_t *spd_cache;
+		size_t spd_cache_sz;
+
+		if (load_spd_cache(&spd_cache, &spd_cache_sz) == CB_SUCCESS &&
+		    spd_cache_is_valid(spd_cache, spd_cache_sz)) {
+			dimm_changed = check_if_dimm_changed(spd_cache, &blk);
+			if (dimm_changed) {
+				printk(BIOS_INFO, "SPD: DIMMs changed, invalidating MRC cache\n");
+				mupd->FspmArchUpd.NvsBufferPtr = 0;
+			} else if (spd_fill_from_cache(spd_cache, &blk) != CB_SUCCESS) {
+				dimm_changed = true;
+			}
+		}
+	}
+
+	if (dimm_changed) {
+		get_spd_smbus(&blk);
+		if (CONFIG(SPD_CACHE_IN_FMAP) && update_spd_cache(&blk) != CB_SUCCESS)
+			printk(BIOS_WARNING, "SPD: updating RW_SPD_CACHE failed\n");
+	}
 	dump_spd_info(&blk);
 
 	mem_cfg->MemorySpdPtr00    = (uintptr_t)blk.spd_array[0];
