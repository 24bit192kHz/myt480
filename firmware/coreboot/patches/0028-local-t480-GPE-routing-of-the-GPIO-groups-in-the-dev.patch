From 197b599dbdf039e45d98cf85faf2def9d23a5347 Mon Sep 17 00:00:00 2001
From: 24bit192khz <118996408+24bit192kHz@users.noreply.github.com>
Date: Thu, 8 Oct 2026 14:08:25 +0300
Subject: [PATCH 28/28] [local] t480: GPE routing of the GPIO groups in the
 devicetree

gpe0_dw0..2 were unset, so the PMC logged "Duplicate GPE DW register values
detected" on every boot and fell back to the MISCCFG default. Set what that
default is on this board (GPIO_GPE_CFG 0x432 read back from PWRMBASE):
GPP_C, GPP_D, GPP_E. Behaviour is unchanged; the EC SCI and wake GPEs now
follow from the devicetree.

---
 .../lenovo/sklkbl_thinkpad/variants/t480/overridetree.cb   | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/src/mainboard/lenovo/sklkbl_thinkpad/variants/t480/overridetree.cb b/src/mainboard/lenovo/sklkbl_thinkpad/variants/t480/overridetree.cb
index a471b63edc..f796cdcfb6 100644
--- a/src/mainboard/lenovo/sklkbl_thinkpad/variants/t480/overridetree.cb
+++ b/src/mainboard/lenovo/sklkbl_thinkpad/variants/t480/overridetree.cb
@@ -9,6 +9,13 @@ chip soc/intel/skylake
 		.tdp_pl2_override = 44,
 	}"
 
+	# GPE routing of the GPIO groups, as the hardware default the PMC fell
+	# back to (GPIO_GPE_CFG 0x432): GPP_C carries the EC's SCI (C22) and
+	# wake (C23) lines, so the EC GPE stays 0x16 and the lid wake 0x17.
+	register "gpe0_dw0" = "GPP_C"
+	register "gpe0_dw1" = "GPP_D"
+	register "gpe0_dw2" = "GPP_E"
+
 	device domain 0 on
 		# The subsystemid of devicetree.cb does not survive this override of the
 		# domain in sconfig, so give it here.
