From c248783b3550575f9116865c1a2d69f6c6915422 Mon Sep 17 00:00:00 2001
From: 24bit192khz <118996408+24bit192kHz@users.noreply.github.com>
Date: Mon, 2 Nov 2026 07:35:38 +0300
Subject: [PATCH 33/33] [local] sklkbl_thinkpad: fan power resource does not
 disengage the fan

Linux's ACPI fan driver puts the fan in D0 on every hibernation freeze,
including the restore kernel's quiesce before the jump to the image.
FPWR._ON then disengages the fan (full speed, unregulated) until the
thermal core turns it off again. Add H8_FAN_PWR_NO_EC so a board can keep
the power resource as pure bookkeeping, and use it on these ThinkPads:
the EC's automatic mode and the OS fan daemon do the cooling.
---
 src/ec/lenovo/h8/acpi/thermal.asl                | 4 ++++
 src/mainboard/lenovo/sklkbl_thinkpad/acpi/ec.asl | 8 ++++++++
 2 files changed, 12 insertions(+)

diff --git a/src/ec/lenovo/h8/acpi/thermal.asl b/src/ec/lenovo/h8/acpi/thermal.asl
index 54f4f922bd..70bbee4148 100644
--- a/src/ec/lenovo/h8/acpi/thermal.asl
+++ b/src/ec/lenovo/h8/acpi/thermal.asl
@@ -105,13 +105,17 @@ External (\PPKG, MethodObj)
 			 * in another ACPI scope. Call a method that does it!
 			 */
 			Method (_ON) {
+#ifndef H8_FAN_PWR_NO_EC
 				\_SB.PCI0.LPCB.EC.FANE(1)
+#endif
 				\FLVL = 1
 				Notify (\_TZ.THM0, NOTIFY_TZ_TRIPPTCHG)
 			}
 
 			Method (_OFF) {
+#ifndef H8_FAN_PWR_NO_EC
 				\_SB.PCI0.LPCB.EC.FANE(0)
+#endif
 				\FLVL = 0
 				Notify (\_TZ.THM0, NOTIFY_TZ_TRIPPTCHG)
 			}
diff --git a/src/mainboard/lenovo/sklkbl_thinkpad/acpi/ec.asl b/src/mainboard/lenovo/sklkbl_thinkpad/acpi/ec.asl
index 27a0027e82..b2399a3d7f 100644
--- a/src/mainboard/lenovo/sklkbl_thinkpad/acpi/ec.asl
+++ b/src/mainboard/lenovo/sklkbl_thinkpad/acpi/ec.asl
@@ -7,6 +7,14 @@
 #define H8_LID_WAKE_STATE 4	/* as the vendor firmware */
 /* EC_WAKE# is GPP_C23 (GPE 0x17 with GPP_C in GPE0_DW0), as the vendor _PRW */
 #define H8_LID_WAKE_GPE 0x17
+/*
+ * The fan power resource leaves the EC alone: _ON disengages the fan (full
+ * speed, unregulated), and Linux's ACPI fan driver turns it on in every
+ * hibernation freeze - also in the restore kernel just before the jump to the
+ * image - so the fan roared through image writes and resumes. The EC's own
+ * automatic mode and the OS fan daemon do the cooling; _CRT and _PSV stay.
+ */
+#define H8_FAN_PWR_NO_EC 1
 
 Name(\TCRT, 100)
 Name(\TPSV, 90)
-- 
