From 3e1c0907f1ae1788ee25f2efead5400891648922 Mon Sep 17 00:00:00 2001
From: 24bit192khz <118996408+24bit192kHz@users.noreply.github.com>
Date: Mon, 28 Sep 2026 20:56:33 +0300
Subject: [PATCH 11/13] mb/lenovo/sklkbl_thinkpad: Request the boot menu after
 a power-button override

The EC keyboard on these ThinkPads only answers ~2.5 s after power-on, so a
payload cannot offer a "hold a key for the menu" check without adding that
to every boot. Use CMOS byte 0x6e instead: 0xb5 asks the payload to show
its menu once (the payload clears it, the OS can set it before a reboot),
and a power-button override (power held 4 s, how a hung boot is turned
off) sets it. Anything else is normalised to 0, since the byte holds
power-on garbage until first written.
---
 .../lenovo/sklkbl_thinkpad/ramstage.c         | 34 +++++++++++++++++++
 1 file changed, 34 insertions(+)

diff --git a/src/mainboard/lenovo/sklkbl_thinkpad/ramstage.c b/src/mainboard/lenovo/sklkbl_thinkpad/ramstage.c
index 2f3198c5a1..2c819ea875 100644
--- a/src/mainboard/lenovo/sklkbl_thinkpad/ramstage.c
+++ b/src/mainboard/lenovo/sklkbl_thinkpad/ramstage.c
@@ -1,8 +1,40 @@
 /* SPDX-License-Identifier: GPL-2.0-only */
 
+#include <console/console.h>
+#include <intelblocks/pmclib.h>
+#include <pc80/mc146818rtc.h>
+#include <soc/pm.h>
 #include <soc/ramstage.h>
 #include "variant.h"
 
+/*
+ * CMOS byte shared with the payload and the OS: 0xb5 asks the payload to
+ * show its boot menu once, anything else means no. site-local GRUB tests and
+ * clears bit 0 ("cmostest 0x6e:0"), the OS writes 0xb5 to reboot into the
+ * menu. The EC keyboard only works ~2.5 s after power-on, too late to ask
+ * with a key.
+ */
+#define CMOS_BOOT_MENU		0x6e
+#define  BOOT_MENU_REQUEST	0xb5
+
+/*
+ * Normalise the byte (it holds power-on garbage until first written) and
+ * turn a power-button override (power held for 4 s, which is how a hung
+ * boot gets turned off) into a menu request for this boot.
+ */
+static void boot_menu_request(void)
+{
+	const struct chipset_power_state *ps = pmc_get_power_state();
+	u8 req = cmos_read(CMOS_BOOT_MENU) == BOOT_MENU_REQUEST ? BOOT_MENU_REQUEST : 0;
+
+	if (ps && (ps->pm1_sts & PRBTNOR_STS))
+		req = BOOT_MENU_REQUEST;
+
+	cmos_write(req, CMOS_BOOT_MENU);
+	if (req)
+		printk(BIOS_INFO, "Boot menu requested\n");
+}
+
 void mainboard_silicon_init_params(FSP_SIL_UPD *params)
 {
 	// Setup GPIOs
@@ -11,6 +43,8 @@ void mainboard_silicon_init_params(FSP_SIL_UPD *params)
 
 static void mainboard_enable(struct device *dev)
 {
+	boot_menu_request();
+
 	if (CONFIG(VARIANT_HAS_DGPU))
 		dgpu_detect();
 }
