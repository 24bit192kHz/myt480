From 6f54f2822327b1ff4a43c757c78d42e276d15e66 Mon Sep 17 00:00:00 2001
From: 24bit192khz <118996408+24bit192kHz@users.noreply.github.com>
Date: Wed, 30 Sep 2026 17:23:18 +0300
Subject: [PATCH 21/28] soc/intel/skylake: GbE ACPI device, wake on root port
 9, board subsystem IDs for FSP

The GbE device now has its ACPI node with the PME wake (Wake-on-LAN shows
up in /proc/acpi/wakeup as on the vendor firmware), root port 9 can wake
the system on a PME (Thunderbolt), and FSP programs the board's subsystem
IDs into the read/write-once registers it touches before coreboot does
(root ports, SMBus, PMC, xHCI, HDA showed Intel's or empty IDs).
---
 src/soc/intel/skylake/acpi/pch.asl  |  3 +++
 src/soc/intel/skylake/acpi/pcie.asl |  3 +++
 src/soc/intel/skylake/chip.c        | 14 +++++++++-----
 3 files changed, 15 insertions(+), 5 deletions(-)

diff --git a/src/soc/intel/skylake/acpi/pch.asl b/src/soc/intel/skylake/acpi/pch.asl
index ba9780881c..380ab1f0f5 100644
--- a/src/soc/intel/skylake/acpi/pch.asl
+++ b/src/soc/intel/skylake/acpi/pch.asl
@@ -43,6 +43,9 @@
 /* USB XHCI 0:14.0 */
 #include "xhci.asl"
 
+/* Gigabit Ethernet 0:1f.6, with its wake capability */
+#include <soc/intel/common/block/acpi/acpi/pch_glan.asl>
+
 /* CSE/HECI #1 0:16.0 */
 #include <soc/intel/common/block/acpi/acpi/heci.asl>
 
diff --git a/src/soc/intel/skylake/acpi/pcie.asl b/src/soc/intel/skylake/acpi/pcie.asl
index 6f4aa82fd9..1336f37620 100644
--- a/src/soc/intel/skylake/acpi/pcie.asl
+++ b/src/soc/intel/skylake/acpi/pcie.asl
@@ -236,6 +236,9 @@ Device (RP09)
 {
 	Name (_ADR, 0x001D0000)
 
+	/* PME from a device behind the port (Thunderbolt) wakes the system */
+	Name (_PRW, Package () { GPE0_PCI_EXP, 4 })
+
 	OperationRegion (RPCS, PCI_Config, 0x4c, 4)
 	Field (RPCS, AnyAcc, NoLock, Preserve)
 	{
diff --git a/src/soc/intel/skylake/chip.c b/src/soc/intel/skylake/chip.c
index c84eb935b9..bcac385936 100644
--- a/src/soc/intel/skylake/chip.c
+++ b/src/soc/intel/skylake/chip.c
@@ -411,11 +411,15 @@ void platform_fsp_silicon_init_params_cb(FSPS_UPD *supd)
 	 */
 	params->SpiFlashCfgLockDown = lockdown_by_fsp;
 
-	/* FSP should let coreboot set subsystem IDs, which are read/write-once */
-	params->DefaultSvid = 0;
-	params->PchSubSystemVendorId = 0;
-	params->DefaultSid = 0;
-	params->PchSubSystemId = 0;
+	/*
+	 * The subsystem IDs are read/write-once. FSP writes those of the PCH
+	 * root ports and of some other devices before coreboot's drivers run,
+	 * so give it the board's IDs; with none configured it leaves them alone.
+	 */
+	params->DefaultSvid = CONFIG_SUBSYSTEM_VENDOR_ID;
+	params->PchSubSystemVendorId = CONFIG_SUBSYSTEM_VENDOR_ID;
+	params->DefaultSid = CONFIG_SUBSYSTEM_DEVICE_ID;
+	params->PchSubSystemId = CONFIG_SUBSYSTEM_DEVICE_ID;
 
 	params->PchPmWolEnableOverride = config->WakeConfigWolEnableOverride;
 	params->PchPmPcieWakeFromDeepSx = config->WakeConfigPcieWakeFromDeepSx;
