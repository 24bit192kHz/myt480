 #define DGPU_PWRGD_TIMEOUT_MS	100
+/* The vendor firmware waits 8 ms between power and the end of the reset */
 #define DGPU_RESET_DELAY_MS	10
 
 /*
@@ -29,7 +30,7 @@ void dgpu_power_on(void)
 {
 	static const struct pad_config pads[] = {
 		PAD_CFG_GPI_TRIG_OWN(GPIO_DISCRETE_PRESENCE, UP_20K, DEEP, OFF, ACPI),
-		PAD_CFG_GPI_TRIG_OWN(GPIO_DGFX_PWRGD, NONE, DEEP, OFF, ACPI),
+		PAD_CFG_GPI_TRIG_OWN(GPIO_DGFX_PWRGD, NONE, DGFX_PWRGD_RESET, OFF, ACPI),
 		PAD_CFG_NF(GPIO_DGFX_CLKREQ, NONE, DEEP, NF1),
 		PAD_CFG_TERM_GPO(GPIO_GPU_RST, 0, UP_20K, RSMRST),
 	};
diff --git a/src/mainboard/lenovo/sklkbl_thinkpad/ramstage.c b/src/mainboard/lenovo/sklkbl_thinkpad/ramstage.c
index eb9cc4aa94..00bf3fa4c1 100644
--- a/src/mainboard/lenovo/sklkbl_thinkpad/ramstage.c
+++ b/src/mainboard/lenovo/sklkbl_thinkpad/ramstage.c
@@ -51,6 +51,9 @@ void mainboard_silicon_init_params(FSP_SIL_UPD *params)
 {
 	// Setup GPIOs
 	variant_config_gpios();
+
+	if (CONFIG(VARIANT_HAS_DGPU))
+		dgpu_wait_for_link();
 }
 
 static void mainboard_enable(struct device *dev)
