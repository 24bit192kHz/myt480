 }
 
 static void *pci_ram_image_start = (void *)PCI_RAM_IMAGE_START;
@@ -288,6 +333,33 @@
 /* ACPI */
 #if CONFIG(HAVE_ACPI_TABLES)
 
+/* Require a complete bounded chain; ignore padding after the last image. */
+static size_t pci_rom_cbfs_images_size(const void *rom, size_t size)
+{
+	size_t total = 0;
+
+	while (total < size) {
+		struct rom_header header;
+		struct pci_data data;
+		const size_t remaining = size - total;
+		if (!pci_rom_cbfs_image_header((const u8 *)rom + total, remaining, &header, &data))
+			return 0;
+
+		const size_t ilen = le16_to_cpu(data.ilen) * 512u;
+		const size_t offset = le16_to_cpu(header.data);
+		const size_t dlen = le16_to_cpu(data.dlen);
+		if (!ilen || ilen > remaining || dlen > ilen || offset > ilen - dlen)
+			return 0;
+		if (data.type == 0 && header.size * 512u > ilen)
+			return 0;
+
+		total += ilen;
+		if (data.indicator & 0x80)
+			return total;
+	}
+	return 0;
+}
+
 static unsigned long
 ati_rom_acpi_fill_vfct(const struct device *device, acpi_vfct_t *vfct_struct,
 		       unsigned long current)
@@ -408,29 +480,40 @@
 	if (rom) {
 		length = rom->size * 512;
 	} else {
-		/* Probe for option rom */
-		rom = pci_rom_probe(device);
-		if (!rom || !rom->size) {
+		/* Retain the size of the mapping that succeeded, including ID fallback. */
+		size_t mapped_size;
+		rom = pci_rom_probe_with_size(device, &mapped_size);
+		if (!rom) {
 			printk(BIOS_WARNING, "%s: Missing PCI Option ROM\n",
 			dev_path(device));
 			return;
 		}
 
+		struct rom_header header;
+		memcpy(&header, (const u8 *)rom, sizeof(header));
+		if (!header.size) {
+			if (mapped_size)
+				cbfs_unmap((void *)rom);
+			return;
+		}
+
 		/* Supports up to four devices. */
 		if ((CBMEM_ID_ROM0 + ngfx) > CBMEM_ID_ROM3) {
 			printk(BIOS_ERR, "%s: Out of CBMEM IDs.\n", dev_path(device));
+			if (mapped_size)
+				cbfs_unmap((void *)rom);
 			return;
 		}
 
-		/* Prepare memory */
-		/* Zero for a ROM that comes from the device: its size is not known */
-		const u32 vendev = map_oprom_vendev((device->vendor << 16) | device->device);
-		const size_t file_size = cbfs_boot_optionrom_size(vendev >> 16, vendev & 0xffff);
-		const size_t cbrom_length = MAX(pci_rom_images_size(rom, file_size),
-						rom->size * 512);
+		/* Reject an incomplete CBFS chain; never enlarge to an unchecked init size. */
+		const size_t cbrom_length = mapped_size ?
+			pci_rom_cbfs_images_size(rom, mapped_size) :
+			MAX(pci_rom_images_size(rom, 0), header.size * 512);
+		/* Device mappings and already-loaded RAM ROMs are still unbounded. */
 		if (!cbrom_length) {
-			printk(BIOS_ERR, "%s: ROM has zero length!\n",
-			dev_path(device));
+			printk(BIOS_ERR, "%s: Invalid or zero-length option ROM!\n", dev_path(device));
+			if (mapped_size)
+				cbfs_unmap((void *)rom);
 			return;
 		}
 
@@ -438,12 +521,16 @@
 		if (!cbrom) {
 			printk(BIOS_ERR, "%s: Failed to allocate CBMEM.\n",
 			dev_path(device));
+			if (mapped_size)
+				cbfs_unmap((void *)rom);
 			return;
 		}
 		/* Increment CBMEM id for next device */
 		ngfx++;
 
-		memcpy(cbrom, rom, cbrom_length);
+		memcpy(cbrom, (const u8 *)rom, cbrom_length);
+		if (mapped_size)
+			cbfs_unmap((void *)rom);
 
 		rom = cbrom;
