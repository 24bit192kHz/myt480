 {
 	char name[17] = "pciXXXX,XXXX.rom";
 
 	snprintf(name, sizeof(name), "pci%04hx,%04hx.rom", vendor, device);
 
-	return cbfs_map(name, NULL);
-}
-
-static size_t cbfs_boot_optionrom_size(uint16_t vendor, uint16_t device)
-{
-	char name[17] = "pciXXXX,XXXX.rom";
-
-	snprintf(name, sizeof(name), "pci%04hx,%04hx.rom", vendor, device);
-
-	return cbfs_get_size(name);
-}
-
-struct rom_header *pci_rom_probe(const struct device *dev)
+	return cbfs_map(name, size);
+}
+
+/* Validate bounded CBFS metadata before any header or PCIR field is read. */
+static bool pci_rom_cbfs_image_header(const void *image, size_t size,
+				    struct rom_header *header, struct pci_data *data)
+{
+	if (size < sizeof(*header))
+		return false;
+	memcpy(header, image, sizeof(*header));
+	if (le16_to_cpu(header->signature) != PCI_ROM_HDR)
+		return false;
+
+	const size_t offset = le16_to_cpu(header->data);
+	if (offset < sizeof(*header) || offset > size || sizeof(*data) > size - offset)
+		return false;
+	memcpy(data, (const u8 *)image + offset, sizeof(*data));
+
+	const size_t dlen = le16_to_cpu(data->dlen);
+	if (le32_to_cpu(data->signature) != PCI_DATA_HDR || dlen < sizeof(*data) ||
+	    dlen > size - offset)
+		return false;
+
+	/* The legacy x86 init area must fit the mapping, even before a copy. */
+	if (data->type == 0 && (!header->size || header->size * 512u > size))
+		return false;
+	return true;
+}
+
+/* size_out is the decompressed CBFS length, or zero for a device ROM. */
+static struct rom_header *pci_rom_probe_with_size(const struct device *dev, size_t *size_out)
 {
 	struct rom_header *rom_header = NULL;
-	struct pci_data *rom_data;
+	struct rom_header header;
+	struct pci_data data;
