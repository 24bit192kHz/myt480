diff --git a/src/mainboard/lenovo/sklkbl_thinkpad/dgpu.c b/src/mainboard/lenovo/sklkbl_thinkpad/dgpu.c
index c4b978fdd0..3f9d18dc9c 100644
--- a/src/mainboard/lenovo/sklkbl_thinkpad/dgpu.c
+++ b/src/mainboard/lenovo/sklkbl_thinkpad/dgpu.c
@@ -1,43 +1,107 @@
 /* SPDX-License-Identifier: GPL-2.0-only */
 
+#include <acpi/acpi.h>
 #include <acpi/acpigen.h>
+#include <cf9_reset.h>
 #include <console/console.h>
 #include <device/device.h>
-#include <device/pci_rom.h>
-#include <option.h>
+#include <gpio.h>
+#include <intelblocks/pmclib.h>
 #include <mainboard/lenovo/sklkbl_thinkpad/variant.h>
-#include <soc/ramstage.h>
+#include <soc/pm.h>
+#include <soc/pmc.h>
 #include <static.h>
 #include <variant/dgpu.h>
 
+static void dgpu_power_off(void)
+{
+	gpio_set(GPIO_GPU_RST, 0);
+	gpio_set(GPIO_1R8VIDEO_AON_ON, 0);
+}
+
+/*
+ * Runtime power management (D3cold) for the GPU: a power resource on its
+ * root port, which calls the methods in acpi/dgpu.asl. Without the GPU, the
+ * PCH may have another root port at the device and function of root port 1,
+ * so only add it for a GPU that is there.
+ */
+void dgpu_fill_ssdt(const struct device *dev)
+{
+	static const char * const power_states[] = { "_PR0", "_PR3" };
+	const struct device *dgpu = DEV_PTR(dgpu);
+	const char *scope;
+
+	if (!is_dev_enabled(dgpu) || !dgpu->upstream)
+		return;
+
+	scope = acpi_device_path(dgpu->upstream->dev);
+	if (!scope)
+		return;
+
+	acpigen_write_scope(scope);
+	acpigen_write_power_res("PGPU", 0, 0, power_states, ARRAY_SIZE(power_states));
+
+	acpigen_write_method("_STA", 0);
+	acpigen_write_return_namestr("DGST");
+	acpigen_write_method_end();
+
+	acpigen_write_method_serialized("_ON", 0);
+	acpigen_emit_namestring("DGON");
+	acpigen_write_method_end();
+
+	acpigen_write_method_serialized("_OFF", 0);
+	acpigen_emit_namestring("DGOF");
+	acpigen_write_method_end();
+
+	acpigen_write_power_res_end();
+	acpigen_write_scope_end();
+}
+
+/* The GPU was powered in the bootblock, see dgpu_early.c */
 void dgpu_detect(void)
 {
 	static const char * const dgfx_vram_id_str[] = { "1GB", "2GB", "4GB", "N/A" };
 	struct device *dgpu = DEV_PTR(dgpu);
-
+	const struct device *rp = dgpu->upstream ? dgpu->upstream->dev : NULL;
 	int dgfx_vram_id;
 
-	// Detect and enable dGPU
-	if (gpio_get(GPIO_DISCRETE_PRESENCE) == 0) { // active low
-		dgfx_vram_id = gpio_get(GPIO_DGFX_VRAM_ID0) | gpio_get(GPIO_DGFX_VRAM_ID1) << 1;
-		printk(BIOS_DEBUG, "Discrete GPU present with %s VRAM\n", dgfx_vram_id_str[dgfx_vram_id]);
-
-		// NOTE: i pulled this GPU enable sequence from thin air
-		// it sometimes works but is buggy and the GPU disappears in some cases so disabling it by default.
-		// also unrelated to this enable sequence the nouveau driver only works on 6.8-6.9 kernels
-		if (get_uint_option("dgpu_enable", 0)) {
-			printk(BIOS_DEBUG, "Enabling discrete GPU\n");
-			gpio_set(GPIO_1R8VIDEO_AON_ON, 1);	// Enable GPU power rail
-			while (!gpio_get(GPIO_DGFX_PWRGD))	// Wait for power good signal from GPU
-				;
-			gpio_set(GPIO_GPU_RST, 1);		// Release GPU from reset
-		} else {
-			printk(BIOS_DEBUG, "Discrete GPU will remain disabled\n");
-			dgpu->enabled = 0;
+	if (gpio_get(GPIO_DISCRETE_PRESENCE) != 0) { // active low
+		printk(BIOS_DEBUG, "Discrete GPU not present\n");
+		dgpu->enabled = 0;
+		return;
+	}
+
+	dgfx_vram_id = gpio_get(GPIO_DGFX_VRAM_ID0) | gpio_get(GPIO_DGFX_VRAM_ID1) << 1;
+	printk(BIOS_DEBUG, "Discrete GPU present with %s VRAM\n", dgfx_vram_id_str[dgfx_vram_id]);
+
+	if (!gpio_tx_get(GPIO_1R8VIDEO_AON_ON)) {
+		printk(BIOS_DEBUG, "Discrete GPU will remain disabled\n");
+		dgpu->enabled = 0;
+		return;
+	}
+
+	/*
+	 * FSP-S disables a root port without a link, and a disabled port stays
+	 * disabled until the next power cycle: FSP-S does not find the GPU on
+	 * the first boot after it was enabled. A full reset cycles the power.
+	 * MEM_SR is only set after a reset without power cycle, so this
+	 * happens once.
+	 */
+	if ((!rp || !rp->enabled) && !acpi_is_wakeup_s3()) {
+		const struct chipset_power_state *ps = pmc_get_power_state();
+
+		if (ps && (ps->gen_pmcon_a & MEM_SR)) {
+			printk(BIOS_INFO, "Discrete GPU: root port is disabled, full reset\n");
+			full_reset();
 		}
+	}
 
-	} else {
-		printk(BIOS_DEBUG, "Discrete GPU not present\n");
+	if (!rp || !rp->enabled) {
+		printk(BIOS_ERR, "Discrete GPU has no PCIe link, powering it off\n");
+		dgpu_power_off();
 		dgpu->enabled = 0;
+		return;
 	}
+
+	printk(BIOS_INFO, "Discrete GPU enabled\n");
 }
diff --git a/src/mainboard/lenovo/sklkbl_thinkpad/dgpu_early.c b/src/mainboard/lenovo/sklkbl_thinkpad/dgpu_early.c
new file mode 100644
index 0000000000..d5e2b16993
--- /dev/null
+++ b/src/mainboard/lenovo/sklkbl_thinkpad/dgpu_early.c
@@ -0,0 +1,72 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+
+#include <arch/io.h>
+#include <console/console.h>
+#include <delay.h>
+#include <gpio.h>
+#include <mainboard/lenovo/sklkbl_thinkpad/variant.h>
+#include <pc80/mc146818rtc.h>
+#include <soc/iomap.h>
+#include <soc/pm.h>
+#include <timer.h>
+#include <variant/dgpu.h>
+
+#define DGPU_PWRGD_TIMEOUT_MS	100
+#define DGPU_RESET_DELAY_MS	10
+
+/*
+ * The dGPU sits behind PCIe root port 1. FSP-S disables root ports that have
+ * no link, so the GPU has to be powered and out of reset well before
+ * FspSiliconInit; the ramstage is too late for that. Do it in the bootblock.
+ *
+ * Root port 1 uses CLKREQ0#, and the PCH only drives the reference clock
+ * while that pad is in its native function, so set it up here as well.
+ *
+ * The power and reset pads are in the RSMRST well and keep their state
+ * across resets and sleep states. Configure them on every boot and resume.
+ */
+void dgpu_power_on(void)
+{
+	static const struct pad_config pads[] = {
+		PAD_CFG_GPI_TRIG_OWN(GPIO_DISCRETE_PRESENCE, UP_20K, DEEP, OFF, ACPI),
+		PAD_CFG_GPI_TRIG_OWN(GPIO_DGFX_PWRGD, NONE, DEEP, OFF, ACPI),
+		PAD_CFG_NF(GPIO_DGFX_CLKREQ, NONE, DEEP, NF1),
+		PAD_CFG_TERM_GPO(GPIO_GPU_RST, 0, UP_20K, RSMRST),
+	};
+	static const struct pad_config power_off[] = {
+		PAD_CFG_TERM_GPO(GPIO_1R8VIDEO_AON_ON, 0, UP_20K, RSMRST),
+	};
+	static const struct pad_config power_on[] = {
+		PAD_CFG_TERM_GPO(GPIO_1R8VIDEO_AON_ON, 1, UP_20K, RSMRST),
+	};
+	struct stopwatch sw;
+
+	gpio_configure_pads(pads, ARRAY_SIZE(pads));
+
+	/* Power held for 4 s is how a hung boot is turned off: drop the request */
+	if (inw(ACPI_BASE_ADDRESS + PM1_STS) & PRBTNOR_STS)
+		cmos_write(0, CMOS_DGPU);
+
+	if (gpio_get(GPIO_DISCRETE_PRESENCE) != 0 ||	/* active low */
+	    cmos_read(CMOS_DGPU) != DGPU_REQUEST) {
+		gpio_configure_pads(power_off, ARRAY_SIZE(power_off));
+		return;
+	}
+
+	gpio_configure_pads(power_on, ARRAY_SIZE(power_on));
+
+	stopwatch_init_msecs_expire(&sw, DGPU_PWRGD_TIMEOUT_MS);
+	while (!gpio_get(GPIO_DGFX_PWRGD)) {
+		if (stopwatch_expired(&sw)) {
+			printk(BIOS_ERR, "dGPU: no power good after %d ms, powering off\n",
+			       DGPU_PWRGD_TIMEOUT_MS);
+			gpio_set(GPIO_1R8VIDEO_AON_ON, 0);
+			return;
+		}
+	}
+	printk(BIOS_DEBUG, "dGPU: power good after %lld us\n",
+	       stopwatch_duration_usecs(&sw));
+
+	mdelay(DGPU_RESET_DELAY_MS);
+	gpio_set(GPIO_GPU_RST, 1);
+}
