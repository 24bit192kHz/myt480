+/* CMOS byte 0x6f: 0xd6 powers the dGPU from the next boot on (`dgpu on` in Linux) */
+#define CMOS_DGPU		0x6f
+#define  DGPU_REQUEST		0xd6
+
+void dgpu_power_on(void);
 void dgpu_detect(void);
+void dgpu_fill_ssdt(const struct device *dev);
 
