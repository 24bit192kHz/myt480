new file mode 100644
index 0000000000..6a4d036bfc
--- /dev/null
+++ b/src/mainboard/lenovo/sklkbl_thinkpad/smihandler.c
@@ -0,0 +1,16 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+
+#include <cpu/x86/smm.h>
+#include <gpio.h>
+#include <variant/dgpu.h>
+
+void mainboard_smi_sleep(u8 slp_typ)
+{
+	/*
+	 * The dGPU power and reset pads keep their state in S3 to S5.
+	 * Hold the GPU in reset and cut its power; the bootblock powers
+	 * it again on resume and on the next boot.
+	 */
+	gpio_set(GPIO_GPU_RST, 0);
+	gpio_set(GPIO_1R8VIDEO_AON_ON, 0);
+}
